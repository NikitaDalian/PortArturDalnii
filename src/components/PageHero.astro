---
// Шапка внутренней страницы: тёмная полоса с крошками, подписью, заголовком, лидом и линией берега.
import Coast from './Coast.astro';
import Crumbs from './Crumbs.astro';
interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs?: Crumb[];
  image?: string | null;      // необязательная картинка справа
  imageAlt?: string;
  caption?: string;
  transitionName?: string;    // для морфинга картинки между списком и страницей
  coastFill?: string;
  imageStyle?: string;        // object-position/object-fit из focusStyle()
  imageMeta?: boolean;        // отдать картинку в результаты поиска (data-pagefind-meta)
}
const { title, eyebrow, lead, crumbs = [], image = null, imageAlt = '', caption, transitionName, coastFill, imageMeta = false, imageStyle } = Astro.props;
---
<section class="page-hero page-top dark">
  <div class="container page-hero__inner page-top__inner" class:list={[{ 'has-img': image }]}>
    <div class="page-hero__text stack" style="--stack-gap:16px">
      <Crumbs items={crumbs} />
      {eyebrow && <p class="eyebrow eyebrow--accent">{eyebrow}</p>}
      <h1 class="h1 page-hero__title" data-pagefind-meta="title">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {image && (
      <figure class="page-hero__fig">
        <img src={image} alt={imageAlt} style={imageStyle} transition:name={transitionName} loading="eager" decoding="async" data-pagefind-meta={imageMeta ? 'image[src], image_alt[alt]' : undefined} />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>
    )}
  </div>
  <Coast fill={coastFill} />
</section>

<style>
  .page-hero__inner { display: flex; flex-wrap: wrap; gap: 32px 48px; align-items: flex-end; }
  .page-hero__text { flex: 1 1 520px; min-width: 0; }
  .page-hero__title { overflow-wrap: break-word; hyphens: auto; }
  .page-hero__fig { flex: 0 1 420px; min-width: 0; }
  .page-hero__fig img { width: 100%; max-height: 420px; object-fit: cover; background: var(--navy-2); }
</style>
