---
import { href } from '../lib/data';
import { t } from '../i18n/ru';
interface Props { section?: string | null }
const { section = null } = Astro.props;
const items = [
  { key: 'layers', label: t.nav.layers, href: href.layers() },
  { key: 'people', label: t.nav.people, href: href.people() },
  { key: 'map', label: t.nav.map, href: href.map() },
  { key: 'library', label: t.nav.library, href: href.library() },
  { key: 'notes', label: t.nav.notes, href: href.notes() },
  { key: 'about', label: t.nav.about, href: href.about() },
];
// Второстепенные разделы — в мобильном меню (на десктопе они в «Карте и маршрутах», «Заметках» и подвале)
const extra = [
  { label: 'Маршруты', href: href.routes() },
  { label: 'Сезоны', href: href.seasons() },
  { label: 'Указатель А–Я', href: href.index() },
];
---
<header class="site-header" transition:name="site-header" data-pagefind-ignore>
  <div class="container site-header__inner">
    <a href={href.home()} class="brand" aria-label={`${t.site} — на главную`}>
      <span class="brand__name">{t.site}</span>
      <span class="brand__tag">{t.tagline}</span>
    </a>
    <nav class="site-nav" aria-label="Основная навигация">
      {items.map((i) => (
        <a href={i.href} aria-current={section === i.key ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>
    <div class="site-header__tools">
      <a href={href.search()} class="icon-btn" aria-label={t.search}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
      </a>
      <span class="lang" title="English и 中文 появятся позже">RU</span>
      <button class="icon-btn menu-btn" aria-label={t.menu} aria-expanded="false" aria-controls="mobile-nav">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path class="l1" d="M4 7h16"></path><path class="l2" d="M4 12h16"></path><path class="l3" d="M4 17h16"></path></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Меню" hidden>
    <div class="container">
      {items.map((i, n) => (
        <a href={i.href} style={`--i:${n}`} aria-current={section === i.key ? 'page' : undefined}>{i.label}</a>
      ))}
      {extra.map((i, n) => (
        <a class="mobile-nav__sub" href={i.href} style={`--i:${items.length + n}`}>{i.label}</a>
      ))}
      <a class="mobile-nav__sub" href={href.search()} style={`--i:${items.length + extra.length}`}>{t.search}</a>
    </div>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--navy); color: #fff; transition: box-shadow .3s; }
  .site-header.is-scrolled { box-shadow: 0 6px 24px rgba(11, 34, 56, .28); }
  .site-header__inner { display: flex; align-items: center; gap: 16px 36px; min-height: var(--header-h); }
  .brand { display: flex; flex-direction: column; gap: 1px; margin-right: auto; }
  .brand__name { font-size: 21px; font-weight: 800; letter-spacing: -0.01em; line-height: 1.1; }
  .brand__tag { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--steel); }
  .site-nav { display: flex; gap: 26px; font-size: 16px; font-weight: 500; color: var(--mist); }
  .site-nav a { position: relative; padding: 6px 0; transition: color .2s; }
  .site-nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease); }
  .site-nav a:hover, .site-nav a[aria-current] { color: #fff; }
  .site-nav a:hover::after, .site-nav a[aria-current]::after { transform: scaleX(1); }
  .site-header__tools { display: flex; align-items: center; gap: 8px; }
  .icon-btn { width: 44px; height: 44px; border-radius: 22px; border: 1px solid var(--sea); background: transparent; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background .2s, border-color .2s; }
  .icon-btn:hover { background: var(--navy-2); border-color: var(--steel); }
  .lang { height: 44px; padding: 0 14px; border: 1px solid var(--sea); border-radius: 22px; display: inline-flex; align-items: center; font-weight: 600; font-size: 14px; }
  .menu-btn { display: none; }
  .menu-btn path { transition: transform .3s var(--ease), opacity .2s; transform-origin: 12px 12px; }
  .menu-btn[aria-expanded='true'] .l1 { transform: translateY(5px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .l2 { opacity: 0; }
  .menu-btn[aria-expanded='true'] .l3 { transform: translateY(-5px) rotate(-45deg); }
  .mobile-nav { border-top: 1px solid var(--sea); padding: 8px 0 24px; max-height: calc(100dvh - var(--header-h)); overflow-y: auto; overscroll-behavior: contain; }
  .mobile-nav a { display: flex; align-items: center; min-height: 56px; font-size: 22px; font-weight: 700; border-bottom: 1px solid var(--sea); animation: navIn .4s var(--ease) both; animation-delay: calc(var(--i) * 35ms); }
  .mobile-nav a[aria-current] { color: var(--accent-on-dark); }
  .mobile-nav a.mobile-nav__sub { min-height: 48px; font-size: 17px; font-weight: 600; color: var(--mist); }
  @keyframes navIn { from { opacity: 0; transform: translateY(10px); } }
  @media (max-width: 1100px) {
    .site-nav, .lang { display: none; }
    .menu-btn { display: inline-flex; }
    .brand__name { font-size: 18px; }
    .brand__tag { font-size: 10px; }
  }
  @media (min-width: 1101px) { .mobile-nav { display: none !important; } }
</style>

<script>
  let onScroll: (() => void) | null = null;
  function initHeader() {
    const header = document.querySelector<HTMLElement>('.site-header');
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const nav = document.getElementById('mobile-nav');
    if (!header || !btn || !nav) return;
    const close = () => { btn.setAttribute('aria-expanded', 'false'); nav.hidden = true; document.body.style.overflow = ''; };
    btn.onclick = () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      nav.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    };
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = () => header.classList.toggle('is-scrolled', scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => {
      close();
      if (onScroll) window.removeEventListener('scroll', onScroll);
      onScroll = null;
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
