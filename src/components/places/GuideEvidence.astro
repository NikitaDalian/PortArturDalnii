---
import { fmtDate } from '../../lib/data';
import type { GuideReview } from '../../lib/evidence';
interface Props { review: GuideReview }
const { review } = Astro.props;
const labels = { confirmed: 'Подтверждено источником', attributed: 'По опубликованным данным', unresolved: 'Остаётся вопрос' };
---
<section class="guide-evidence" id="proverka-istochnikov" aria-labelledby="evidence-title">
  <p class="eyebrow">Работа с источниками</p>
  <h2 class="h3" id="evidence-title">Что удалось проверить</h2>
  <p class="evidence-scope">{review.scope}</p>
  <p class="meta evidence-byline">{review.editor} · <time datetime={review.checkedAt}>{fmtDate(review.checkedAt)}</time></p>
  <div class="evidence-checks">
    {review.checks.map(check => <details id={`check-${check.id}`}>
      <summary><span class="evidence-status">{labels[check.status]}</span><span class="evidence-heading">{check.title}</span></summary>
      <div class="evidence-detail">
        <p>{check.finding}</p>
        <p class="meta evidence-links"><a href={`#${check.section}`}>К разделу статьи</a><span>Источники: {check.refs.map(ref => <a href={`#istochnik-${ref}`}>[{ref}]</a>)}</span></p>
      </div>
    </details>)}
  </div>
  {review.revisions.length > 0 && <details class="evidence-revisions">
    <summary>Уточнения этой редакции</summary>
    <ul>{review.revisions.map(revision => <li><time datetime={revision.date}>{fmtDate(revision.date)}</time><p>{revision.note}</p></li>)}</ul>
  </details>}
</section>
<style>
  .guide-evidence { margin-top: 64px; padding-top: 32px; border-top: 2px solid var(--navy); scroll-margin-top: calc(var(--header-h) + 24px); }
  .guide-evidence .eyebrow { margin-bottom: 12px; }
  .guide-evidence h2 { font-size: clamp(25px, 2.5vw, 32px); margin-bottom: 20px; }
  .evidence-scope { font-size: 17px; line-height: 1.75; }
  .evidence-byline { margin: 12px 0 24px; }
  .evidence-checks details { border-top: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 24px); }
  .evidence-checks details:last-child { border-bottom: 1px solid var(--line); }
  summary { display: block; position: relative; list-style: none; cursor: pointer; padding: 18px 28px 18px 0; min-height: 44px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); color: var(--accent-on-light); font-size: 24px; font-weight: 400; }
  details[open] > summary::after { content: '−'; }
  .evidence-status { display: block; font-size: 12px; color: var(--ink-3); margin-bottom: 6px; }
  .evidence-heading { font-size: 18px; line-height: 1.5; font-weight: 650; }
  .evidence-detail { padding: 0 0 18px; line-height: 1.75; }
  .evidence-links { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 20px; margin-top: 12px; }
  .evidence-links a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: 3px; }
  .evidence-links span a { min-width: 36px; justify-content: center; }
  .evidence-revisions { margin-top: 16px; font-size: 14px; line-height: 1.65; }
  .evidence-revisions ul { padding-left: 20px; }
  .evidence-revisions li + li { margin-top: 16px; }
  .evidence-revisions time { color: var(--ink-3); }
  @media (max-width: 540px) { .guide-evidence { margin-top: 44px; } }
</style>
