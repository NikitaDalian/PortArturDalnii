---
// Типографская обложка заметки без картинки: тёмный фон, силуэт сопок, метка типа, годы слоя крупно. Пропорция 3:2.
import { TYPES, layerByKey, type Article } from '../lib/data';
interface Props { a: Pick<Article, 'type' | 'layer'>; class?: string; compact?: boolean }
const { a, class: cls = '', compact = false } = Astro.props;
const type = TYPES[a.type] ?? TYPES.event;
const keys = (a.layer ?? []) as string[];
const ls = keys.map((k) => layerByKey(k)).filter(Boolean) as NonNullable<ReturnType<typeof layerByKey>>[];
const first = ls[0]?.years ?? '';
const last = ls[ls.length - 1]?.years ?? '';
const startY = first.split('–')[0].replace('до ', '').replace('после ', '');
const endY = last.includes('–') ? last.split('–')[1] : last.replace('до ', '').replace('после ', '');
const years = ls.length === 0 ? '' : last.startsWith('после') ? (ls.length === 1 ? 'после 1955' : `с ${startY}`) : ls.length === 1 || first === last ? first : `${startY}–${endY}`;
---
<div class:list={['note-cover', cls, { 'note-cover--compact': compact }]} style={`--c:${type.color}`} role="img" aria-label={`${type.label}${years ? ', ' + years : ''}`}>
  <span class="note-cover__tag">{type.label}</span>
  {years && <span class="note-cover__years">{years}</span>}
  <svg class="note-cover__hills" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 80 C60 52 110 60 170 74 C230 88 280 40 350 46 C420 52 470 84 540 66 C570 58 590 62 600 66 V120 H0Z" fill="#2D4A63" />
    <path d="M0 104 C70 84 130 96 210 100 C290 104 330 78 410 82 C480 86 540 102 600 94 V120 H0Z" fill="#8FB3C9" opacity=".55" />
  </svg>
</div>

<style>
  .note-cover { position: relative; overflow: hidden; width: 100%; aspect-ratio: 3 / 2; background: var(--navy-2); color: var(--steel); border-top: 6px solid var(--c); display: flex; flex-direction: column; justify-content: flex-start; padding: 18px 20px; }
  .note-cover__tag { font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .9; position: relative; z-index: 1; }
  .note-cover__years { position: relative; z-index: 1; margin-top: 8px; font-size: clamp(30px, 5.2vw, 52px); font-weight: 800; line-height: 1; color: #fff; letter-spacing: -.01em; }
  .note-cover__hills { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 38%; }
  .note-cover--compact { padding: 6px 8px; border-top-width: 3px; }
  .note-cover--compact .note-cover__tag { font-size: 9px; }
  .note-cover--compact .note-cover__years { font-size: 15px; margin-top: 2px; }
</style>
