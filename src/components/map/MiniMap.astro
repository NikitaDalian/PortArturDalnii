---
// Небольшая карта на странице места или маршрута: точки (с номерами) и линия.
import { places, href } from '../../lib/data';
interface Pt { lat: number; lng: number; n?: number | string; name: string; href?: string; main?: boolean; summary?: string }
interface Props { points: Pt[]; line?: [number, number][] | null; label: string; height?: string; zoom?: number }
const { points, line = null, label, height = '360px', zoom = 14.5 } = Astro.props;
const enriched = points.map((point) => {
  const place = places.find((p) => point.href === href.place(p.slug) || (p.name === point.name && p.lat === point.lat && p.lng === point.lng));
  return { ...point, summary: point.summary ?? place?.summary?.split(/(?<=[.!?])\s+|(?<=[。！？])/).slice(0, 2).join(' ') };
});
const cfg = JSON.stringify({ points: enriched, line, zoom }).replace(/</g, '\\u003c');
---
<div class="minimap" style={`--h:${height}`}>
  <div class="minimap__map" data-minimap={cfg} role="region" aria-label={label}></div>
  <noscript><p class="minimap__nojs">Для карты нужен JavaScript.</p></noscript>
</div>

<script>
  import { loadMapLibre, webglOk } from './ml';
  import { osmStyle } from './geo';
  let maps: any[] = [];
  async function init() {
    const els = [...document.querySelectorAll<HTMLElement>('[data-minimap]')].filter((e) => !e.dataset.ready);
    if (!els.length) return;
    if (!webglOk()) { els.forEach((e) => (e.innerHTML = '<p class="minimap__nojs">Браузер не поддерживает WebGL.</p>')); return; }
    const ml = await loadMapLibre();
    for (const el of els) {
      el.dataset.ready = '1';
      const { points, line, zoom } = JSON.parse(el.dataset.minimap!);
      if (!points.length || !el.isConnected) continue;
      const map = new ml.Map({
        container: el, style: osmStyle() as any, attributionControl: false,
        center: [points[0].lng, points[0].lat], zoom,
        cooperativeGestures: true, dragRotate: false, touchPitch: false, pitchWithRotate: false,
      });
      map.addControl(new ml.AttributionControl({ compact: false }), 'bottom-right');
      map.addControl(new ml.NavigationControl({ showCompass: false }), 'top-right');
      maps.push(map);
      let activePopup: any = null;
      for (const p of points) {
        const m = document.createElement('button');
        m.type = 'button';
        m.className = 'mm-mk' + (p.main ? ' is-main' : '');
        m.setAttribute('aria-label', `О месте: ${p.name}`);
        m.setAttribute('aria-expanded', 'false');
        m.title = p.name;
        const dot = document.createElement('span');
        dot.textContent = p.n == null ? '' : String(p.n);
        dot.setAttribute('aria-hidden', 'true');
        m.append(dot);
        const content = document.createElement('div');
        content.className = 'mm-card';
        const title = document.createElement('h3');
        title.textContent = p.name;
        content.append(title);
        if (p.summary) { const text = document.createElement('p'); text.textContent = p.summary; content.append(text); }
        if (p.href) {
          const link = document.createElement('a');
          link.href = p.href; link.textContent = 'Подробнее о месте'; content.append(link);
        }
        const popup = new ml.Popup({ offset: 20, maxWidth: '260px', focusAfterOpen: true, className: 'mm-popup' }).setDOMContent(content);
        const marker = new ml.Marker({ element: m }).setLngLat([p.lng, p.lat]).addTo(map);
        m.addEventListener('click', (event) => {
          event.stopPropagation();
          if (popup.isOpen()) { popup.remove(); return; }
          activePopup?.remove(); activePopup = popup;
          popup.setLngLat(marker.getLngLat()).addTo(map);
        });
        popup.on('open', () => {
          m.setAttribute('aria-expanded', 'true');
          const panel = popup.getElement();
          panel?.querySelector('button')?.setAttribute('aria-label', 'Закрыть справку');
          if (panel) panel.onkeydown = (event: KeyboardEvent) => { if (event.key === 'Escape') { popup.remove(); m.focus(); } };
        });
        popup.on('close', () => { m.setAttribute('aria-expanded', 'false'); });
        m.addEventListener('keydown', (event) => { if (event.key === 'Escape') popup.remove(); });
      }
      map.on('load', () => {
        if (line && line.length > 1) {
          map.addSource('l', { type: 'geojson', data: { type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: line.map((p: number[]) => [p[1], p[0]]) } } as any });
          map.addLayer({ id: 'lc', type: 'line', source: 'l', layout: { 'line-join': 'round', 'line-cap': 'round' }, paint: { 'line-color': '#fff', 'line-width': 7, 'line-opacity': .9 } });
          map.addLayer({ id: 'll', type: 'line', source: 'l', layout: { 'line-join': 'round', 'line-cap': 'round' }, paint: { 'line-color': '#E0452B', 'line-width': 3.5, 'line-dasharray': [2, 1.4] } });
        }
        const all = [...points.map((p: any) => [p.lat, p.lng]), ...(line || [])];
        if (all.length > 1) {
          const la = all.map((p: number[]) => p[0]), lo = all.map((p: number[]) => p[1]);
          map.fitBounds([[Math.min(...lo), Math.min(...la)], [Math.max(...lo), Math.max(...la)]], { padding: 48, maxZoom: zoom, duration: 0 });
        }
      });
    }
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { maps.forEach((m) => { try { m.remove(); } catch {} }); maps = []; });
</script>

<style is:global>
  .minimap { position: relative; height: var(--h); background: var(--map-bg); overflow: hidden; }
  .minimap__map { position: absolute; inset: 0; }
  .minimap .maplibregl-ctrl-group button { width: 44px; height: 44px; }
  .minimap__nojs { padding: 16px; font-size: 15px; color: var(--ink-2); }
  .mm-mk { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; border: 0; padding: 0; background: transparent; }
  .mm-card { color: var(--ink); font: 14px/1.55 var(--font); padding: 12px 8px 4px; max-height: 220px; overflow-y: auto; }
  .mm-card h3 { font-size: 17px; line-height: 1.3; padding-right: 20px; margin-bottom: 10px; }
  .mm-card p { margin: 0; }
  .mm-card a { display: inline-flex; align-items: center; min-height: 44px; margin-top: 4px; font-weight: 650; text-decoration: underline; color: var(--accent-on-light); }
  .mm-popup .maplibregl-popup-close-button { width: 44px; height: 44px; font-size: 24px; color: var(--ink); }
  .mm-mk > span { min-width: 28px; height: 28px; padding: 0 4px; border-radius: 14px; border: 3px solid #fff; background: var(--navy); color: #fff; font: 700 13px var(--font); display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(11, 34, 56, .35); }
  .mm-mk.is-main > span { background: var(--accent); width: 32px; height: 32px; border-radius: 16px; }
  .mm-mk:focus-visible { outline: none; }
  .mm-mk:focus-visible > span { outline: 3px solid var(--accent); outline-offset: 2px; }
</style>
