---
// Карточка источника (архив, альбом, лекция, видео, музыка) со ссылкой на его страницу.
import { href, img, focusStyle, type Source } from '../../lib/data';
import { sourceKindLabel } from './labels';
interface Props { s: Source }
const { s } = Astro.props;
const pic = img(s.image, 640);
---
<a href={href.source(s.slug)} class="card src-card">
  <div class="card__media">
    {pic
      ? <img class="card__img" src={pic} alt="" loading="lazy" decoding="async" transition:name={`source-${s.slug}`} style={focusStyle(s.image)} />
      : <div class="card__img src-card__ph" aria-hidden="true"><span>{sourceKindLabel(s.kind)}</span></div>}
  </div>
  <span class="meta">{sourceKindLabel(s.kind)}{s.author ? ` · ${s.author}` : ''}</span>
  <span class="h3 card__title src-card__title">{s.title}</span>
</a>

<style>
  .src-card { gap: 8px; }
  .src-card .card__img { aspect-ratio: 16 / 10; }
  .src-card__ph { display: flex; align-items: flex-end; padding: 16px; background: var(--frost); color: var(--ink-3);
    font-weight: 700; border-top: 6px solid var(--t-source); }
  .src-card__title { font-size: 19px; }
</style>
