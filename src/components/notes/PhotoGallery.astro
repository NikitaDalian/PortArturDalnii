---
// Фотографии поста: превью 640 px; по клику — лайтбокс (<dialog>) с листанием
// кнопками, клавишами ← → Esc и свайпом. Без библиотек.
import { img, focusStyle, photoMeta } from '../../lib/data';
interface Props { photos: string[]; title?: string }
const { photos: files, title = 'Фотографии поста' } = Astro.props;
const items = files
  .map((f) => ({ full: img(f), thumb: img(f, 640), caption: (photoMeta(f)?.subject as string | undefined) ?? '', st: files.length > 1 ? focusStyle(f) : undefined }))
  .filter((p) => p.full && p.thumb);
---
{items.length > 0 && (
  <section class="pg" aria-label={title}>
    <h2 class="h3">{title} <span class="meta">· {items.length}</span></h2>
    <ul class="pg-grid" class:list={[{ 'pg-grid--one': items.length === 1 }]}>
      {items.map((p, i) => (
        <li>
          <button type="button" class="pg-thumb" data-i={i} aria-label={`Открыть фото ${i + 1} из ${items.length}${p.caption ? ': ' + p.caption : ''}`}>
            <img src={p.thumb} alt={p.caption} loading="lazy" decoding="async" style={p.st} />
          </button>
        </li>
      ))}
    </ul>
    <dialog class="pg-box" aria-label="Просмотр фотографий">
      <div class="pg-stage">
        <img class="pg-img" alt="" />
        <p class="pg-cap"><span class="pg-num"></span> <span class="pg-text"></span></p>
      </div>
      <button type="button" class="pg-btn pg-close" aria-label="Закрыть">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
      {items.length > 1 && (
        <>
          <button type="button" class="pg-btn pg-prev" aria-label="Предыдущее фото">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
          </button>
          <button type="button" class="pg-btn pg-next" aria-label="Следующее фото">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
          </button>
        </>
      )}
      <script type="application/json" class="pg-data" set:html={JSON.stringify(items.map((p) => ({ src: p.full, cap: p.caption })))}></script>
    </dialog>
  </section>
)}

<style>
  .pg { display: flex; flex-direction: column; gap: 16px; }
  .pg-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(180px, 46%), 1fr)); }
  .pg-grid--one { grid-template-columns: minmax(0, 520px); }
  .pg-thumb { display: block; width: 100%; padding: 0; border: 0; background: var(--frost); cursor: zoom-in; overflow: hidden; }
  .pg-thumb img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .5s var(--ease); }
  .pg-grid--one .pg-thumb img { aspect-ratio: auto; max-height: 520px; object-fit: contain; }
  .pg-thumb:hover img { transform: scale(1.04); }

  .pg-box { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(6, 18, 30, .96); color: #fff; overflow: hidden; }
  .pg-box::backdrop { background: rgba(6, 18, 30, .9); }
  .pg-box[open] { display: flex; animation: pg-in .25s var(--ease); }
  @keyframes pg-in { from { opacity: 0; } }
  .pg-stage { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 64px 16px 20px; min-width: 0; touch-action: pan-y; }
  .pg-img { max-width: min(100%, 1400px); max-height: calc(100dvh - 150px); object-fit: contain; user-select: none; -webkit-user-drag: none; transition: transform .25s var(--ease), opacity .25s; }
  .pg-cap { max-width: 72ch; text-align: center; font-size: 15px; line-height: 1.45; color: var(--mist); }
  .pg-num { font-weight: 700; color: #fff; margin-right: 6px; }
  .pg-btn { position: absolute; width: 52px; height: 52px; border-radius: 26px; border: 1px solid var(--sea); background: rgba(11, 34, 56, .7); color: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .pg-btn:hover { background: var(--navy-2); border-color: var(--steel); }
  .pg-close { top: 12px; right: 12px; }
  .pg-prev { left: 12px; top: 50%; transform: translateY(-50%); }
  .pg-next { right: 12px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 720px) {
    .pg-prev, .pg-next { top: auto; bottom: 16px; transform: none; }
    .pg-stage { padding-bottom: 84px; }
    .pg-img { max-height: calc(100dvh - 200px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pg-thumb img, .pg-img { transition: none; }
    .pg-box[open] { animation: none; }
  }
</style>

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLElement>('.pg').forEach((root) => {
      const box = root.querySelector<HTMLDialogElement>('.pg-box');
      const data = root.querySelector('.pg-data');
      if (!box || !data || box.dataset.ready) return;
      box.dataset.ready = '1';
      const items: { src: string; cap: string }[] = JSON.parse(data.textContent || '[]');
      const im = box.querySelector<HTMLImageElement>('.pg-img')!;
      const num = box.querySelector<HTMLElement>('.pg-num')!;
      const txt = box.querySelector<HTMLElement>('.pg-text')!;
      const stage = box.querySelector<HTMLElement>('.pg-stage')!;
      let i = 0;
      let opener: HTMLElement | null = null;

      const show = (n: number) => {
        i = (n + items.length) % items.length;
        im.src = items[i].src;
        im.alt = items[i].cap;
        num.textContent = items.length > 1 ? `${i + 1} / ${items.length}` : '';
        txt.textContent = items[i].cap;
        // подгружаем соседей заранее
        [i + 1, i - 1].forEach((k) => { const p = items[(k + items.length) % items.length]; if (p) new Image().src = p.src; });
      };
      root.querySelectorAll<HTMLButtonElement>('.pg-thumb').forEach((b) => {
        b.addEventListener('click', () => { opener = b; show(Number(b.dataset.i)); box.showModal(); document.documentElement.style.overflow = 'hidden'; });
      });
      box.addEventListener('close', () => { document.documentElement.style.overflow = ''; opener?.focus(); });
      box.querySelector('.pg-close')!.addEventListener('click', () => box.close());
      box.querySelector('.pg-prev')?.addEventListener('click', () => show(i - 1));
      box.querySelector('.pg-next')?.addEventListener('click', () => show(i + 1));
      box.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
      });
      // клик по фону закрывает
      stage.addEventListener('click', (e) => { if (e.target === stage) box.close(); });
      // свайп
      let x0 = 0, y0 = 0, dragging = false;
      stage.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') return; x0 = e.clientX; y0 = e.clientY; dragging = true; });
      stage.addEventListener('pointermove', (e) => {
        if (!dragging || items.length < 2) return;
        const dx = e.clientX - x0;
        if (Math.abs(dx) > Math.abs(e.clientY - y0)) im.style.transform = `translateX(${dx}px)`;
      });
      const end = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        const dx = e.clientX - x0, dy = e.clientY - y0;
        im.style.transform = '';
        if (items.length > 1 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(dx < 0 ? i + 1 : i - 1);
      };
      stage.addEventListener('pointerup', end);
      stage.addEventListener('pointercancel', () => { dragging = false; im.style.transform = ''; });
      document.addEventListener('astro:before-swap', () => { if (box.open) box.close(); }, { once: true });
    });
  }
  document.addEventListener('astro:page-load', initGalleries);
</script>
