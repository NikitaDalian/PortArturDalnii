---
import { fmtDate, tgPost } from '../../lib/data';
import { locale } from '../../i18n/locale';
import { originalsFor } from '../../lib/telegramOriginals';
interface Props { posts: ReturnType<typeof originalsFor> }
const { posts } = Astro.props;
const copy = {
  ru: {title:'Оригинал заметки', part:'Публикация', discuss:'Обсудить в Telegram', via:'Переслано из'},
  en: {title:'Original note in Russian', part:'Post', discuss:'Discuss on Telegram', via:'Forwarded from'},
  zh: {title:'俄文原文', part:'原帖', discuss:'前往 Telegram 讨论', via:'转发自'},
}[locale];
---
<section aria-labelledby="original" class="originals">
  <h2 class="h2" id="original">{copy.title}</h2>
  {posts.map((post, i) => <section class="post" id={`post-${post.id}`}>
    <header class="meta">
      {posts.length > 1 && <strong>{copy.part} {i + 1} · </strong>}
      <time datetime={post.date}>{fmtDate(post.date.slice(0, 10))}</time>
      {post.forwardedFrom && <span> · {copy.via} <span lang="ru">{post.forwardedFrom}</span></span>}
    </header>
    <div class="prose post-body" lang="ru" set:html={post.html} />
    <a class="text-link" href={tgPost(post.id)} rel="noopener" target="_blank">{copy.discuss} ↗</a>
  </section>)}
</section>
<style>
  .post { max-width:68ch; margin-top:1.2rem; }
  .post + .post { border-top:1px solid var(--line); margin-top:2rem; padding-top:1.5rem; }
  .post-body { margin-block:.8rem 1.25rem; overflow-wrap:anywhere; }
  .post-body :global(p) { white-space:pre-wrap; }
  .post-body :global(blockquote) { margin-inline:0; padding-left:1rem; border-left:3px solid var(--line); }
  .post-body :global(a) { text-decoration:underline; text-underline-offset:.16em; }
</style>
