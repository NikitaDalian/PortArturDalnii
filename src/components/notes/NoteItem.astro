---
// Элемент каталога заметок. Один и тот же HTML показывается карточкой или строкой —
// вид задаёт класс родителя (.nc-list--grid / .nc-list--rows).
import { href, img, focusStyle, entity, TYPES, fmtDateShort, type Article } from '../../lib/data';
interface Props { a: Article }
const { a } = Astro.props;
const t = TYPES[a.type] ?? TYPES.event;
const cover = img(a.cover, 640);
const who = a.people.slice(0, 3).map((s) => entity('person', s).label);
const allNames = [
  ...a.people.map((s) => entity('person', s).label),
  ...a.places.map((s) => entity('place', s).label),
].join(' ');
const text = `${a.title} ${a.dek} ${allNames}`.toLowerCase().replace(/ё/g, 'е');
---
<li
  class="nc-item"
  data-type={a.type}
  data-layers={a.layer.join(' ')}
  data-series={a.series_slug ?? ''}
  data-people={a.people.join(' ')}
  data-places={a.places.join(' ')}
  data-date={a.date}
  data-tg={a.tg_ids[0]}
  data-read={a.read_min}
  data-text={text}
>
  <a href={href.note(a.slug)} class="nc-link" style={`--tc:${t.color}`}>
    <span class="nc-media">
      {cover
        ? <img src={cover} alt="" loading="lazy" decoding="async" transition:name={`note-${a.slug}`} style={focusStyle(a.cover)} />
        : <span class="nc-ph"><span>{t.label}</span></span>}
    </span>
    <span class="nc-bar" aria-hidden="true"></span>
    <span class="nc-body">
      <span class="meta nc-meta"><span class="nc-dot" aria-hidden="true"></span>{t.label} · {fmtDateShort(a.date)} · {a.read_min} мин</span>
      <span class="nc-title">{a.title}</span>
      <span class="nc-dek">{a.dek}</span>
      {who.length > 0 && <span class="nc-who">{who.join(', ')}{a.people.length > 3 ? ' и др.' : ''}</span>}
    </span>
  </a>
</li>

<style>
  .nc-item { list-style: none; min-width: 0; }
  .nc-link { display: flex; flex-direction: column; gap: 12px; height: 100%; }
  .nc-media { display: block; overflow: hidden; background: var(--frost); aspect-ratio: 3 / 2; }
  .nc-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .nc-link:hover .nc-media img { transform: scale(1.03); }
  .nc-ph { display: flex; align-items: flex-end; height: 100%; padding: 16px; background: var(--navy-2); color: var(--steel); font-weight: 700; border-top: 6px solid var(--tc); }
  .nc-bar { display: none; }
  .nc-body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .nc-meta { display: inline-flex; align-items: center; gap: 7px; }
  .nc-dot { width: 9px; height: 9px; border-radius: 3px; background: var(--tc); flex: none; }
  .nc-title { font-size: var(--fs-h3); line-height: 1.2; font-weight: 700; letter-spacing: -0.01em; }
  .nc-link:hover .nc-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .nc-dek { font-size: 16px; line-height: 1.45; color: var(--ink-2); }
  .nc-who { font-size: 14px; color: var(--ink-3); }

  /* вид «список» */
  :global(.nc-list--rows) .nc-link { flex-direction: row; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  :global(.nc-list--rows) .nc-media { order: 3; flex: 0 0 120px; width: 120px; aspect-ratio: 4 / 3; }
  :global(.nc-list--rows) .nc-ph { padding: 8px; font-size: 12px; border-top-width: 4px; }
  :global(.nc-list--rows) .nc-bar { display: block; align-self: stretch; flex: 0 0 4px; border-radius: 2px; background: var(--tc); }
  :global(.nc-list--rows) .nc-body { flex: 1; }
  :global(.nc-list--rows) .nc-dot { display: none; }
  :global(.nc-list--rows) .nc-title { font-size: 19px; line-height: 1.25; }
  :global(.nc-list--rows) .nc-dek { font-size: 15px; }
  @media (max-width: 520px) {
    :global(.nc-list--rows) .nc-link { gap: 12px; padding: 14px 0; }
    :global(.nc-list--rows) .nc-media { flex-basis: 76px; width: 76px; }
    :global(.nc-list--rows) .nc-title { font-size: 17px; }
    :global(.nc-list--rows) .nc-who { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .nc-media img { transition: none; } }
</style>
