---
// Шкала эпох: ширина сегмента пропорциональна длительности слоя.
// На телефоне — вертикальный список с полосой пропорциональной длины.
import { href, type LayerKey } from '../../lib/data';
import { LAYERS, SPAN } from './layers';
interface Props { current?: LayerKey; label?: string }
const { current, label = 'Шкала эпох' } = Astro.props;
const max = Math.max(...Object.values(SPAN));
const NOW = new Date().getFullYear();
---
<nav class="tl reveal" aria-label={label}>
  <ol class="tl__list">
    {LAYERS.map((l, i) => (
      <li class="tl__item" style={`--grow:${SPAN[l.key]}; --w:${((SPAN[l.key] / max) * 100).toFixed(1)}%; --i:${i}`} data-layer={l.key}>
        <a href={href.layer(l.key)} class="tl__seg" aria-current={current === l.key ? 'page' : undefined}>
          <span class="tl__bar" aria-hidden="true"></span>
          <span class="tl__years">{l.years}</span>
          <span class="tl__name">{l.short}</span>
          <span class="sr-only">— {l.title}</span>
        </a>
      </li>
    ))}
  </ol>
  <p class="tl__note meta">Длина сегментов пропорциональна годам: 7, 40, 10 и {NOW - 1955}. Отрезок «до 1898» показан условно.</p>
</nav>

<style>
  .tl__list { list-style: none; margin: 0; padding: 0; display: flex; gap: 3px; }
  .tl__item { flex: var(--grow) 1 0; min-width: 112px; }
  .tl__seg { display: flex; flex-direction: column; gap: 6px; min-height: var(--tap); padding-bottom: 6px; border-radius: 2px; }
  .tl__bar {
    display: block; height: 56px; background: var(--c, var(--sea));
    transform: scaleX(0); transform-origin: left center;
    transition: transform 900ms var(--ease), background .2s;
    transition-delay: calc(var(--i) * 140ms + 150ms);
  }
  .tl.is-in .tl__bar { transform: scaleX(1); }
  .tl__item[data-layer="pre1898"] { --c: var(--line-2); }
  .tl__item[data-layer="russian"] { --c: var(--navy); }
  .tl__item[data-layer="japanese"] { --c: var(--sea); }
  .tl__item[data-layer="soviet"] { --c: var(--ink-3); }
  .tl__item[data-layer="modern"] { --c: var(--steel); }
  .tl__seg:hover .tl__bar { filter: brightness(1.15); }
  .tl__seg[aria-current="page"] .tl__bar { box-shadow: inset 0 -6px 0 var(--accent); }
  .tl__seg[aria-current="page"] .tl__years { font-weight: 800; }
  .tl__years { font-size: 15px; font-weight: 700; line-height: 1.2; }
  .tl__name { font-size: 14px; line-height: 1.3; color: var(--ink-2); }
  .tl__seg:hover .tl__name, .tl__seg[aria-current="page"] .tl__name { color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .tl__note { margin-top: 12px; }

  @media (max-width: 720px) {
    .tl__list { flex-direction: column; gap: 0; border-top: 1px solid var(--line); }
    .tl__item { min-width: 0; border-bottom: 1px solid var(--line); }
    .tl__seg { display: grid; grid-template-columns: 96px 1fr; grid-template-areas: "years name" "bar bar"; gap: 4px 12px; padding: 12px 0; align-items: baseline; }
    .tl__years { grid-area: years; }
    .tl__name { grid-area: name; font-size: 15px; }
    .tl__bar { grid-area: bar; height: 14px; width: max(var(--w), 10px); }
  }

  /* без JS и при просьбе уменьшить движение полосы видны сразу */
  :global(.no-js) .tl__bar { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .tl__bar { transform: none; transition: none; }
  }
</style>
