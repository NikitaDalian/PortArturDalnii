---
// Фирменный разделитель в конце тёмной секции: два плавных ряда сопок, как на иллюстрациях сайта.
// fill — цвет следующей секции (по умолчанию фон страницы). variant="flat" — ровный край без линии.
interface Props { fill?: string; flip?: boolean; variant?: 'hills' | 'flat' }
const { fill = 'var(--ice)', flip = false, variant = 'hills' } = Astro.props;
---
{variant === 'flat' ? null : (
  <svg class="coast" viewBox="0 0 1440 56" preserveAspectRatio="none" aria-hidden="true" style={flip ? 'transform:scaleY(-1)' : undefined}>
    <g class="coast__back">
      <path d="M-40 30 C 80 16, 190 10, 320 22 S 560 40, 700 24 S 930 6, 1070 18 S 1320 38, 1480 20 V56 H-40 Z" />
    </g>
    <path class="coast__front" d="M0 42 C 150 34, 270 28, 400 36 S 640 50, 780 41 S 1020 27, 1160 36 S 1350 47, 1440 40 V56 H0 Z" style={`fill:${fill}`} />
  </svg>
)}

<style>
  .coast { display: block; width: 100%; height: clamp(22px, 3.6vw, 52px); margin-top: -1px; overflow: visible; }
  .coast__back path { fill: var(--sea); opacity: .55; }
  @supports (animation-timeline: view()) {
    .coast__back { animation: coastDrift linear both; animation-timeline: view(); animation-range: entry 0% exit 100%; }
    @keyframes coastDrift { from { transform: translateX(-18px); } to { transform: translateX(18px); } }
  }
  @media (max-width: 720px) { .coast__back { display: none; } }
  @media (prefers-reduced-motion: reduce) { .coast__back { animation: none; } }
</style>
