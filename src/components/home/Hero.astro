---
// Первый экран главной: широкая иллюстрация гавани, заголовок в «небе» картинки, мягкий параллакс.
import { href, url } from '../../lib/data';
const src = (s: string) => url(`/img/gen/${s}.webp`);
---
<section class="hero">
  <picture class="hero__art" aria-hidden="true">
    <source media="(max-width: 720px)" srcset={src('hero-home-1280')} />
    <img class="hero__img" src={src('hero-home')} alt="" width="2560" height="1097" loading="eager" fetchpriority="high" decoding="async" data-parallax />
  </picture>
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow eyebrow--accent hero__in" style="--hd:0ms">Ляодунский полуостров · 1898–1955</p>
      <h1 class="display hero__title hero__in" style="--hd:80ms">Два города на&nbsp;краю Ляодуна</h1>
      <p class="lead hero__lead hero__in" style="--hd:200ms">
        Семь лет под русским флагом, сорок — под японским, десять — под советским. Сегодня это Далянь и Люйшунь.
        Здесь собрано то, что от тех лет осталось: события, люди, книги и места, куда можно дойти пешком.
      </p>
      <div class="cluster hero__actions hero__in" style="--cluster-gap:12px; --hd:320ms">
        <a class="btn btn--primary" href={href.layers()}>
          Начать с истории
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="btn btn--outline" href={href.map()}>Открыть карту</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: #EEF2F4; min-height: min(calc(100vw * 1097 / 2560), 88vh); display: flex; }
  .hero__art { position: absolute; inset: 0; }
  .hero__img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 100%; will-change: transform; }
  .hero__inner { position: relative; width: 100%; padding-top: clamp(32px, 5vw, 72px); padding-bottom: 32px; }
  .hero__text { max-width: 600px; }
  .hero__title { margin-top: 18px; color: var(--navy); }
  .hero__lead { margin-top: 22px; max-width: 520px; color: var(--ink-2); }
  .hero__actions { margin-top: 30px; }

  @keyframes heroIn { from { opacity: 0; transform: translateY(18px); } }
  .hero__in { animation: heroIn .9s var(--ease) both; animation-delay: var(--hd, 0ms); }
  @keyframes artIn { from { opacity: 0; transform: scale(1.04); } }
  .hero__art { animation: artIn 1.4s var(--ease) both; }

  /* на средних экранах текст ложится на светлую плашку, чтобы не спорить с картинкой */
  @media (max-width: 1180px) and (min-width: 721px) {
    .hero__text { background: rgba(244, 247, 248, .9); padding: 24px 28px 28px; margin-left: calc(var(--gutter) * -0.5); }
  }
  @media (max-width: 720px) {
    .hero { flex-direction: column; min-height: 0; }
    .hero__art { position: relative; order: 2; height: 260px; }
    .hero__img { object-position: 78% 100%; }
    .hero__inner { order: 1; padding-top: 28px; padding-bottom: 8px; }
    .hero__actions { flex-direction: column; align-items: stretch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__in, .hero__art { animation: none; }
  }
</style>

<script>
  // Лёгкий параллакс иллюстрации: только десктоп и без reduced-motion.
  let raf = 0;
  let onScroll: (() => void) | null = null;
  function initParallax() {
    const el = document.querySelector<HTMLElement>('[data-parallax]');
    if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches || innerWidth < 720) return;
    onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const y = Math.min(scrollY, innerHeight);
        el.style.transform = `translate3d(0, ${y * 0.18}px, 0) scale(1.02)`;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  document.addEventListener('astro:page-load', initParallax);
  document.addEventListener('astro:before-swap', () => {
    if (onScroll) window.removeEventListener('scroll', onScroll);
    cancelAnimationFrame(raf);
    onScroll = null;
  });
</script>
