---
// «Серии»: циклы заметок. Без картинок: название, число заметок и первые заголовки цикла.
import { series, articleBySlug, href, plural } from '../../lib/data';
const list = [...series]
  .sort((a, b) => (b.articles?.length ?? 0) - (a.articles?.length ?? 0))
  .slice(0, 6)
  .map((s) => {
    const arts = (s.articles ?? []).map((x) => articleBySlug.get(x)).filter(Boolean) as any[];
    return { slug: s.slug, title: s.title, n: arts.length, titles: arts.slice(0, 3).map((a) => a.title as string) };
  });
---
<section class="section container" aria-labelledby="series-h">
  <div class="section-head reveal">
    <div class="stack" style="--stack-gap:8px">
      <h2 id="series-h" class="h2">Серии</h2>
      <p class="muted">Циклы из нескольких постов, которые лучше читать подряд.</p>
    </div>
    <a class="link" href={href.seriesList()}>Все серии · {series.length}</a>
  </div>
  <ul class="series" role="list">
    {list.map((s, i) => (
      <li class="reveal" style={`--d:${Math.min(i, 5) * 70}ms`}>
        <a class="series__card" href={href.series(s.slug)}>
          <span class="series__n">{s.n} {plural(s.n, 'заметка', 'заметки', 'заметок')}</span>
          <span class="series__title">{s.title}</span>
          <ol class="series__list">
            {s.titles.map((t) => <li>{t}</li>)}
          </ol>
          <span class="series__go">Читать подряд</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .series { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  .series > li { display: flex; }
  .series__card { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 22px 24px 20px; background: var(--paper); border: 1px solid var(--line); border-top: 4px solid var(--navy); transition: transform .3s var(--ease), box-shadow .3s; }
  .series__card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(11, 34, 56, .1); }
  .series__n { font-size: var(--fs-meta); font-weight: 600; color: var(--ink-3); }
  .series__title { font-size: 21px; font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; }
  .series__card:hover .series__title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .series__list { margin: 4px 0 0; padding: 0 0 0 18px; display: flex; flex-direction: column; gap: 4px; font-size: 15px; line-height: 1.4; color: var(--ink-2); }
  .series__list li { padding-left: 2px; }
  .series__go { margin-top: auto; padding-top: 10px; font-size: 15px; font-weight: 600; color: var(--accent-on-light, var(--accent)); }
  .series__go::after { content: ' →'; }
  @media (max-width: 720px) { .series__card { padding: 18px 18px 16px; } .series__list li:nth-child(n + 3) { display: none; } }
  @media (prefers-reduced-motion: reduce) { .series__card, .series__card:hover { transition: none; transform: none; } }
</style>
