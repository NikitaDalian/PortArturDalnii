---
import type { WalkGuide } from '../../lib/walks';
interface Props { guide: WalkGuide }
const { guide } = Astro.props;
---
<section class="section section--tight walk-overview" aria-labelledby="walk-before">
  <div class="container">
    <div class="walk-overview__head">
      <div><p class="eyebrow">Короткая прогулка</p><h2 class="h2" id="walk-before">Перед выходом</h2></div>
      <button class="btn btn--outline" type="button" data-walk-print>Сохранить или распечатать</button>
    </div>
    <dl class="walk-overview__grid">
      <div><dt>Начало</dt><dd>{guide.start}</dd></div>
      <div><dt>Финиш</dt><dd>{guide.finish}</dd></div>
      <div class="walk-overview__time"><dt>Переходы</dt><dd>{guide.walkingMinutes.join('–')} <span>мин</span></dd></div>
      <div class="walk-overview__time"><dt>Осмотр</dt><dd>{guide.visitMinutes.join('–')} <span>мин</span></dd></div>
    </dl>
    <p class="walk-overview__distance">{guide.distanceNote}</p>
    <p class="walk-overview__access">{guide.access}</p>
  </div>
</section>
<script>
  function initWalkPrint() {
    document.querySelectorAll<HTMLButtonElement>('[data-walk-print]:not([data-ready])').forEach(button => {
      button.dataset.ready = '1';
      button.addEventListener('click', () => window.print());
    });
  }
  document.addEventListener('astro:page-load', initWalkPrint);
</script>
<style>
  .walk-overview__head { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:28px; }
  .walk-overview__grid { display:grid; grid-template-columns:2fr 2fr 1fr 1fr; gap:28px; margin:0; }
  dt { font-size:12px; text-transform:uppercase; letter-spacing:.08em; font-weight:700; color:var(--ink-3); margin-bottom:8px; }
  dd { margin:0; font-size:16px; line-height:1.6; }
  .walk-overview__time dd { font-size:28px; line-height:1.2; font-weight:600; color:var(--navy); }
  .walk-overview__time span { display:block; font-size:14px; font-weight:400; margin-top:4px; }
  .walk-overview__distance { margin:24px 0 0; padding-top:20px; border-top:1px solid var(--line); color:var(--ink-3); max-width:85ch; font-size:14px; }
  .walk-overview__access { margin:12px 0 0; max-width:85ch; line-height:1.65; }
  @media(max-width:850px) { .walk-overview__grid { grid-template-columns:1fr 1fr; } }
  @media(max-width:560px) { .walk-overview__head { align-items:flex-start; flex-direction:column; } .walk-overview__grid > :nth-child(-n+2) { grid-column:1/-1; } }
  @media print { [data-walk-print] { display:none; } .walk-overview__grid { grid-template-columns:1fr 1fr; } }
</style>
