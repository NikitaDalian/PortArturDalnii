---
// Строка книги в каталоге и в блоках «Книги» на других страницах.
import { href, imgCrop, BOOK_LEVELS, type Book } from '../lib/data';
interface Props { b: Book; showCover?: boolean; morph?: boolean }
const { b, showCover = true, morph = true } = Astro.props;
const lvl = BOOK_LEVELS[b.level] ?? BOOK_LEVELS.deep;
const cover = imgCrop(b.cover, '4x5', 640);
---
<a href={href.book(b.slug)} class="row book-row" data-level={b.level} data-kind={b.kind}>
  {showCover && (cover
    ? <img class="book-row__cover" src={cover} alt="" loading="lazy" decoding="async" transition:name={morph ? `book-${b.slug}` : undefined} />
    : <span class="book-row__cover book-row__ph" aria-hidden="true"></span>)}
  <span class="stack" style="--stack-gap:6px; min-width:0">
    <span class="tag" style={`background:${lvl.color}`}>{lvl.label}</span>
    <span class="row__title book-row__title">{b.title}</span>
    <span class="meta" style="font-size:15px">{b.author}{b.year ? `, ${b.year}` : ''}</span>
    <span class="muted book-row__verdict">{b.verdict}</span>
  </span>
</a>

<style>
  .book-row { align-items: flex-start; }
  .book-row__cover { flex: 0 0 76px; width: 76px; height: 108px; object-fit: cover; box-shadow: 0 2px 8px rgba(11,34,56,.18); background: var(--frost); }
  .book-row__ph { background: var(--frost); border-left: 4px solid var(--line-2); }
  .book-row__title { font-size: 21px; font-weight: 700; line-height: 1.2; }
  .book-row__verdict { font-size: 15px; line-height: 1.45; }
  @media (max-width: 520px) { .book-row__cover { flex-basis: 60px; width: 60px; height: 86px; } .book-row__title { font-size: 18px; } }
</style>
