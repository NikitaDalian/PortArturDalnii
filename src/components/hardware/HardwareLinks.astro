---
import { hardwareFor, type HardwareRelation } from '../../lib/hardware';
import { href } from '../../lib/data';
interface Props { kind: HardwareRelation; slug: string }
const { kind, slug } = Astro.props;
const items = hardwareFor(kind, slug);
---
{items.length > 0 && <nav class="hardware-links" aria-label="Корабли и вооружение по теме" data-pagefind-ignore>
  <h2 class="h3">Корабли и вооружение</h2>
  <ul>{items.map(item => <li><a href={href.hardware(item.slug)}>{item.name}</a><span>{item.category}</span></li>)}</ul>
  <a class="text-link" href={href.hardwareIndex()}>Весь раздел</a>
</nav>}
<style>
  .hardware-links { border-top:1px solid var(--line); padding-block:24px; }
  h2 { margin-bottom:16px; }
  ul { list-style:none; padding:0; margin:0 0 16px; display:grid; gap:12px; }
  li { display:flex; flex-direction:column; gap:4px; }
  li a { font-size:18px; text-decoration:underline; text-underline-offset:4px; }
  li span { font-size:14px; color:var(--ink-2); }
</style>
