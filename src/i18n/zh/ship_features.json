      }
    ],
    "photoFile": "/images/hardware/hatsuse-jane1904.webp"
  },
  {
    "shipSlug": "yashima",
    "period": "武器数据为1904年战争开始时的日本海军配置。据档案条目，“八岛”号照片摄于1904年5月以前；确切日期、地点不详。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，305毫米",
        "x": 17,
        "y": 64,
        "text": "四门305毫米阿姆斯特朗炮成对设在舰艏、舰艉炮座。十门152毫米炮中，一部分设于炮廓内，其他布置在较高位置、由防盾保护。即使同属中口径火炮，炮员所获防护也不同。主炮口径与较晚的“三笠”号相似，并不意味着炮座结构、弹药输送方式相同。",
        "weaponSlug": "armstrong-305-40",
        "refs": [
          1,
          2
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "两座烟囱",
        "x": 52,
        "y": 47,
        "text": "“八岛”号有两座烟囱、两台三胀式蒸汽机和两根推进轴，采用圆筒式锅炉。参考资料对锅炉数量记载不一，此处不取单一数值。虽然都为双烟囱，它的锅炉配置仍有别于较晚的“三笠”号。",
        "weaponSlug": null,
        "refs": [
          1,
          2
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Yashima_NH_58968.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 48,
        "y": 26,
        "text": "两根战斗桅杆和低矮、厚重的舰艏舰艉炮座，构成紧凑轮廓。档案条目将照片年代定为1904年5月以前，未给出确切日期、地点。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Yashima_NH_58968.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舷侧装甲带",
        "x": 55,
        "y": 73,
        "text": "主装甲带最厚处达457毫米，采用哈维装甲。这并不意味着整个舷侧都有这一厚度，也不意味着防护能力是“初濑”号的两倍。材料、防护面积及整体方案均有差别。",
        "weaponSlug": null,
        "refs": [
          1,
          2
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/yashima-nh58968.webp"
