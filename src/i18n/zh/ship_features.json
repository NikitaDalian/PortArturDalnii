[
  {
    "shipSlug": "petropavlovsk",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。照片摄于“彼得罗巴甫洛夫斯克”号1904年沉没之前。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，305毫米",
        "x": 84,
        "y": 63,
        "text": "四门305毫米炮组成主炮，舰艏、舰艉各有一座双联装炮塔。口径是炮膛的直径，这里为30.5厘米。十二门较小的152毫米炮另行布置：八门装在四座舷侧炮塔内，另四门设在炮房中。",
        "weaponSlug": "obukhov-305-40",
        "refs": [
          2
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "两座烟囱",
        "x": 52,
        "y": 47,
        "text": "两座烟囱位于两根桅杆之间。十四座圆筒式锅炉为两台三胀式蒸汽机供汽，主机驱动两副螺旋桨。烟囱数量并不等于锅炉数量：舰内锅炉要多得多。",
        "weaponSlug": null,
        "refs": [
          2
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Petropavlovsk_-_NH_84769-A.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 40,
        "y": 33,
        "text": "前桅带有较大的战斗桅盘。后桅显得更轻巧。这种形状差别有助于辨认老照片中的军舰。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Petropavlovsk_-_NH_84769-A.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舷侧与装甲带",
        "x": 62,
        "y": 66,
        "text": "水线附近的重要舷侧由装甲带防护，最厚处达406毫米。这并非整个舰体表面的厚度。甲板、炮塔另有各自的防护，水雷爆炸则可能发生在装甲带以下。",
        "weaponSlug": null,
        "refs": [
          2
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/petropavlovsk-1.webp"
  },
  {
    "shipSlug": "poltava",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。“波尔塔瓦”号照片的确切拍摄日期、地点不详。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，305毫米",
        "x": 66,
        "y": 67,
        "text": "主炮为四门奥布霍夫工厂制造的305毫米炮，舰艏、舰艉各两门。中口径炮的布置不同：八门152毫米炮装在四座炮塔内，另四门设在炮房中。因此，较小的舷侧炮塔并不是更多的主炮塔。",
        "weaponSlug": "obukhov-305-40",
        "refs": [
          1
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "两座烟囱",
        "x": 35,
        "y": 53,
        "text": "两座烟囱在轮廓上标出了锅炉区域。“波尔塔瓦”号的十四座圆筒式锅炉为两台蒸汽机供汽，主机驱动两副螺旋桨。同级的“塞瓦斯托波尔”号有十六座锅炉，烟囱却也只有两座。",
        "weaponSlug": null,
        "refs": [
          1,
          4
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Poltava-Chesma.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 51,
        "y": 27,
        "text": "前桅明显比后桅粗重，并带有高位战斗桅盘。所选照片可见这一特征，但确切拍摄日期不详。因此，不能据此确定战争中某一天桅杆小型设备的准确状态。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Poltava-Chesma.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舷侧与炮房",
        "x": 56,
        "y": 80,
        "text": "八门152毫米炮两两装入四座舷侧炮塔，另四门设在炮房中，中口径炮的布置与防护因而并不一致。",
        "weaponSlug": null,
        "refs": [
          1
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/poltava-2.webp"
  },
  {
    "shipSlug": "sevastopol",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。照片为1900年喀琅施塔得的“塞瓦斯托波尔”号。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，305毫米",
        "x": 76,
        "y": 57,
        "text": "舰体两端的大炮塔各装两门305毫米炮。此外，“塞瓦斯托波尔”号还有十二门152毫米加奈炮：八门装在四座较小的炮塔内，四门设在炮房中。",
        "weaponSlug": "obukhov-305-40",
        "refs": [
          1
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "两座烟囱",
        "x": 50,
        "y": 44,
        "text": "虽然同“波尔塔瓦”号一样只有两座烟囱，舰内锅炉配置却不同：圆筒式锅炉为十六座，而非十四座。两台蒸汽机驱动两副螺旋桨。因此，不能凭烟囱数推算锅炉数，也不能把一艘同级舰的数据直接套到另一艘上。",
        "weaponSlug": null,
        "refs": [
          1
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Sevastopol1900Kronshtadt.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 69,
        "y": 27,
        "text": "所选照片摄于1900年的喀琅施塔得，可以辨认出两根桅杆。前桅带有战斗桅盘。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Sevastopol1900Kronshtadt.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舷侧与炮房",
        "x": 55,
        "y": 63,
        "text": "八门152毫米炮两两装入四座舷侧炮塔，另四门设在炮房中，中口径炮的布置与防护因而并不一致。",
        "weaponSlug": null,
        "refs": [
          1
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/sevastopol-1.webp"
  },
  {
    "shipSlug": "retvizan",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。照片为1902年特拉华河上的“列特维赞”号。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，305毫米",
        "x": 75,
        "y": 67,
        "text": "舰艏、舰艉的炮塔各装两门奥布霍夫工厂制造的305毫米炮。十二门152毫米加奈炮采用炮廓布置，炮组位于舷侧炮房的受保护空间内。数量指战争初期的完整配置；围城期间，部分武器曾移交岸上。",
        "weaponSlug": "obukhov-305-40",
        "refs": [
          1,
          4
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "三座烟囱",
        "x": 42,
        "y": 47,
        "text": "“列特维赞”号有三座烟囱。二十四座尼克劳斯水管锅炉为两台主机供汽。烟囱数有助于辨认轮廓，却无法说明甲板下有多少锅炉，也不能说明军舰受损后还能保持多大航速。",
        "weaponSlug": null,
        "refs": [
          1,
          4
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Retvizan1902DelawareRiver.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 52,
        "y": 23,
        "text": "两根粗重桅杆位于三座烟囱的两侧，其上可辨认出战斗桅盘。照片摄于1902年的特拉华河，早于战争和旅顺围城。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Retvizan1902DelawareRiver.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舷侧装甲",
        "x": 55,
        "y": 79,
        "text": "主装甲带最厚处达229毫米，炮塔装甲的最大厚度也为这一数值。这些数字并不意味着整个舰体防护均匀。",
        "weaponSlug": null,
        "refs": [
          1,
          4
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/retvizan-1.webp"
  },
  {
    "shipSlug": "bayan",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。照片为1903年夏喀琅施塔得的“巴扬”号。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，203毫米",
        "x": 24,
        "y": 68,
        "text": "“巴扬”号只有两门主炮：舰艏、舰艉炮塔各装一门203毫米炮，并非战列舰的双联装炮塔。另有八门152毫米加奈炮布置在两舷。这套武器适合随舰队侦察、支援轻型舰艇的巡洋舰。",
        "weaponSlug": "obukhov-203-45",
        "refs": [
          1,
          2,
          3
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "四座烟囱",
        "x": 55,
        "y": 49,
        "text": "四座烟囱是第一艘“巴扬”号的显著特征之一。二十六座贝尔维尔锅炉为两台三胀式蒸汽机供汽。设计航速约21节，这是设计指标，并非每次出航都能保证达到的速度。",
        "weaponSlug": null,
        "refs": [
          1,
          3
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Bayan1903Kronstadt.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 35,
        "y": 23,
        "text": "两根细桅杆与相邻战列舰的粗重战斗桅杆不同。照片可以确认其大致外形和位置。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Bayan1903Kronstadt.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舷侧装甲",
        "x": 52,
        "y": 78,
        "text": "“巴扬”号是装甲巡洋舰，舷侧装甲带最厚处达200毫米，炮塔由150毫米装甲防护。这有别于主要依靠内部装甲甲板保护动力装置的防护巡洋舰。",
        "weaponSlug": null,
        "refs": [
          1,
          3
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/bayan-1.webp"
  },
  {
    "shipSlug": "mikasa",
    "period": "武器数据为1904年战争开始时的日本海军配置。“三笠”号是东乡平八郎的旗舰。图片刊于美国海军军医威廉·C.布雷斯特德1906年出版的报告；确切拍摄日期、地点未注明。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，305毫米",
        "x": 56,
        "y": 56,
        "text": "四门305毫米炮成对装入舰艏、舰艉炮塔，属于埃尔斯威克／阿姆斯特朗出口系列，并非同口径的俄国火炮。两座主炮塔之间设有十四门152毫米炮，炮廓用装甲保护火炮及炮组。",
        "weaponSlug": "armstrong-305-40",
        "refs": [
          1,
          2,
          10
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "两座烟囱",
        "x": 46,
        "y": 47,
        "text": "“三笠”号有两座烟囱，却有二十五座贝尔维尔锅炉。两台三胀式蒸汽机驱动两副螺旋桨；纪念馆列出的功率为15000马力，航速为18节。",
        "weaponSlug": null,
        "refs": [
          1,
          2
        ],
        "sourceUrls": [
          "https://www.govinfo.gov/app/details/SERIALSET-04915_00_00-002-0328-0000"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 51,
        "y": 31,
        "text": "前后桅杆均带有战斗桅盘，与两座宽烟囱共同构成其典型轮廓。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://www.govinfo.gov/app/details/SERIALSET-04915_00_00-002-0328-0000"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舷侧与内部防护",
        "x": 62,
        "y": 63,
        "text": "“三笠”号用于战列舰列阵作战，舷侧与重要内部区域有装甲保护。中口径炮的炮廓是火炮和炮组各自所在的受保护空间。照片可以显示其大致区域，却不能显示装甲厚度或舰内防护结构。",
        "weaponSlug": null,
        "refs": [
          1,
          2
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/essays/mikasa.webp"
  },
  {
    "shipSlug": "novik",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。据照片条目，“诺维克”号摄于1904年的旅顺；确切日期不详。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，120毫米",
        "x": 87,
        "y": 60,
        "text": "“诺维克”号的主要武器是六门单装120毫米加奈炮。这样的巡洋舰可以支援己方驱逐舰，但主炮的威力低于装备152毫米炮的大型巡洋舰。",
        "weaponSlug": "canet-120-45",
        "refs": [
          1,
          2,
          8
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "三座烟囱",
        "x": 52,
        "y": 51,
        "text": "三座烟囱构成“诺维克”号轻巧、快速的轮廓。十二座水管锅炉为三台主机供汽，每台各驱动一副螺旋桨。最后五次试航测得的平均航速为25.08节；单次纪录不能当作恒定的作战航速。",
        "weaponSlug": null,
        "refs": [
          1,
          2
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Novik1904Port-Artur.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆",
        "x": 31,
        "y": 26,
        "text": "“诺维克”号只有一根高桅杆。在所选照片中，它位于最后一座和中间一座烟囱之间。这是一个特别而实用的辨认特征。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Novik1904Port-Artur.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舰内装甲甲板",
        "x": 57,
        "y": 75,
        "text": "“诺维克”号是防护巡洋舰，没有舷侧装甲带。舰内装甲甲板保护主机等重要部位，其两侧以斜面下降至舷侧。这层甲板位于舰内，从外部无法看见。",
        "weaponSlug": null,
        "refs": [
          1,
          2
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/novik-port-arthur.webp"
  },
  {
    "shipSlug": "varyag",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。据照片条目，“瓦良格”号摄于1901年6月；确切地点不详。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，152毫米",
        "x": 17,
        "y": 63,
        "text": "“瓦良格”号装有十二门152毫米加奈炮，采用露天单装甲板炮架，没有大型装甲炮塔。十二门是全舰总数，并不是能同时向同一舷开火的炮数。",
        "weaponSlug": "canet-152-45",
        "refs": [
          2,
          3
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "四座烟囱",
        "x": 57,
        "y": 52,
        "text": "1901年的照片和弗雷德·简1904年著作中的示意图中，都可见四座细长烟囱。甲板下有三十座尼克劳斯锅炉，两台主机驱动两副螺旋桨。验收试航达到约23节，但后来的修理与磨损，使这一数值不能代表海战中每一时刻的航速。",
        "weaponSlug": null,
        "refs": [
          1,
          3
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Varyag1901.jpg",
          "https://www.gutenberg.org/files/74624/74624-h/74624-h.htm#P_341"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 27,
        "y": 34,
        "text": "两根细桅杆立在四座烟囱的两侧，大致外形已同1901年照片和弗雷德·简1904年著作中的示意图核对。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Varyag1901.jpg",
          "https://www.gutenberg.org/files/74624/74624-h/74624-h.htm#P_341"
        ]
      },
      {
        "id": "hull-protection",
        "label": "防护巡洋舰的舰体",
        "x": 51,
        "y": 69,
        "text": "“瓦良格”号属于防护巡洋舰，舰内重要部位由装甲甲板保护，没有厚重的舷侧装甲带。甲板炮仍是露天布置。",
        "weaponSlug": null,
        "refs": [
          2,
          3
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/varyag-1901.webp"
  },
  {
    "shipSlug": "tsesarevich",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。照片为1903年土伦的“皇太子”号。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，305毫米",
        "x": 73,
        "y": 70,
        "text": "舰体两端的炮塔各装两门305毫米炮。十二门152毫米加奈炮也全部装入炮塔，共六座双联装。这是它与“波尔塔瓦”级的重要区别：后者部分中口径炮仍设在炮房中。",
        "weaponSlug": "obukhov-305-40",
        "refs": [
          1,
          2
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "两座烟囱",
        "x": 51,
        "y": 51,
        "text": "两座宽烟囱位于粗重桅杆之间。二十座贝尔维尔锅炉供汽，两台蒸汽机各驱动一根推进轴。照片摄于1903年的土伦，早于战时受损及后续修理。",
        "weaponSlug": null,
        "refs": [
          4
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Tsesarevich1903Toulon.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 60,
        "y": 28,
        "text": "两根粗重桅杆均有分层布置的较大战斗桅盘，与高舷侧共同构成这个法国设计的鲜明外形。照片摄于1903年的土伦。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Tsesarevich1903Toulon.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舷侧与防雷舱壁",
        "x": 62,
        "y": 81,
        "text": "舷侧有两道装甲带保护，舰内另设纵向防雷舱壁，即在水下爆炸后限制进水蔓延的额外隔壁。它在外部不可见。该舰在战争第一夜遭鱼雷命中后仍保持浮力。",
        "weaponSlug": null,
        "refs": [
          1,
          2
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/tsesarevich-1.webp"
  },
  {
    "shipSlug": "peresvet",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。照片为1901年土伦的“佩列斯韦特”号。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，254毫米",
        "x": 69,
        "y": 60,
        "text": "四门254毫米炮成对装入舰艏、舰艉炮塔，主炮口径小于“波尔塔瓦”号或“皇太子”号的305毫米。艏炮塔比艉炮塔高，轮廓中可清楚看出升高的前部甲板，即艏楼。这里不显示后来日本海军的武器配置。",
        "weaponSlug": "obukhov-254-45",
        "refs": [
          1,
          3
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "三座烟囱",
        "x": 47,
        "y": 49,
        "text": "三座烟囱和高舰艏，有助于将它与双烟囱的“波尔塔瓦”级区分开。三十座贝尔维尔锅炉为三台蒸汽机供汽，各驱动一根轴。它与“胜利”号外形相似，并不意味着武器、防护完全相同。",
        "weaponSlug": null,
        "refs": [
          1
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Peresvet1901.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 62,
        "y": 28,
        "text": "两根桅杆都有战斗桅盘。后桅桅盘，有助于把“佩列斯韦特”号的原始外形与后桅较轻的“胜利”号区分开。这一差别由1901年照片和梅利尼科夫的结构描述共同确认。",
        "weaponSlug": null,
        "refs": [
          1
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Peresvet1901.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舷侧装甲带",
        "x": 67,
        "y": 77,
        "text": "装甲带保护舰体的重要区域，但整个舷侧的防护并不一致。煤和其他载荷会改变装甲带露出水面的高度。因此，不能仅凭一项厚度或一条外轮廓线判断防护能力，还需要装甲布置图及装载状态。",
        "weaponSlug": null,
        "refs": [
          1,
          3
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/peresvet-1.webp"
  },
  {
    "shipSlug": "pobeda",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。照片中的“胜利”号处于俄国服役时期，拍摄时间在1900至1904年之间。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，254毫米",
        "x": 68,
        "y": 73,
        "text": "两座炮塔共装四门254毫米炮，每座两门。艏炮塔高于艉炮塔，位于升高的前部甲板——艏楼上。十一门152毫米加奈炮组成原始中口径炮组。",
        "weaponSlug": "obukhov-254-45",
        "refs": [
          1
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "三座烟囱",
        "x": 43,
        "y": 48,
        "text": "三座烟囱下方设有三十座贝尔维尔锅炉和三台蒸汽机，各驱动一根轴。从舰艏方向拍摄时，烟囱会部分重叠。",
        "weaponSlug": null,
        "refs": [
          1
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Pobeda_1900-1904.jpg",
          "https://commons.wikimedia.org/wiki/File:Pobeda1904Port-Artur.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 50,
        "y": 22,
        "text": "前桅有战斗桅盘，后桅则较轻，没有这种大型桅盘。这是它与“佩列斯韦特”号之间一个实用的辨认差别。所选照片中两根桅杆部分重叠，因此又以梅利尼科夫的结构描述核实了两桅的差异。",
        "weaponSlug": null,
        "refs": [
          1
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Pobeda_1900-1904.jpg",
          "https://commons.wikimedia.org/wiki/File:Pobeda1904Port-Artur.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "高舷侧与艏楼",
        "x": 66,
        "y": 86,
        "text": "前部甲板即艏楼高于舰艉，因此艏、艉炮塔位于不同高度。这是“胜利”号与“佩列斯韦特”号的共同特征。不过设计仍有变化：“胜利”号采用了更先进的装甲。外形相似不等于防护相同。",
        "weaponSlug": null,
        "refs": [
          1
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/pobeda-1.webp"
  },
  {
    "shipSlug": "askold",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。照片为1901年在基尔试航的“阿斯科尔德”号。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，152毫米",
        "x": 12,
        "y": 58,
        "text": "十二门152毫米加奈炮布置在甲板上，炮位带有防盾。防盾只能部分保护炮组，并非封闭装甲炮塔。较小口径火炮主要用于抵御驱逐舰攻击。",
        "weaponSlug": "canet-152-45",
        "refs": [
          1,
          4
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "五座烟囱",
        "x": 56,
        "y": 42,
        "text": "五座高烟囱是“阿斯科尔德”号最容易辨认的特征，服务于十九座舒尔茨—桑尼克罗夫特锅炉。三台主机驱动三副螺旋桨。烟囱数量本身并非战斗力的尺度：火炮、防护及机械状态也同样重要。",
        "weaponSlug": null,
        "refs": [
          1,
          4
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Askold1901Kiel.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 37,
        "y": 24,
        "text": "两根细桅杆分立于五座烟囱的两侧，没有“皇太子”号那样粗重、带多层桅盘的战斗桅杆。照片摄于1901年在基尔的试航。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Askold1901Kiel.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舰内装甲甲板",
        "x": 40,
        "y": 68,
        "text": "主要动力装置与弹药库上方有装甲甲板保护，两侧以斜面下降至舷侧。“阿斯科尔德”号没有连续的舷侧装甲带，因此称为防护巡洋舰。这层甲板在外部不可见，舷侧标记只是将说明与舰体对应起来。",
        "weaponSlug": null,
        "refs": [
          1,
          4
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/askold-1.webp"
  },
  {
    "shipSlug": "pallada",
    "period": "武器数据为俄国服役时期、1904年初的原始配置。照片为20世纪初的“帕拉达”号，早于日本打捞、改名。",
    "features": [
      {
        "id": "main-artillery",
        "label": "主炮，152毫米",
        "x": 78,
        "y": 61,
        "text": "“帕拉达”号最初有八门152毫米加奈炮，使用甲板炮架，没有战列舰式的主炮塔。围城期间，部分火炮和人员转到陆上阵地，因此不能把原始八门自动视为1904年任何一天的配置。",
        "weaponSlug": "canet-152-45",
        "refs": [
          1,
          3
        ],
        "sourceUrls": []
      },
      {
        "id": "funnels",
        "label": "三座烟囱",
        "x": 42,
        "y": 46,
        "text": "三座烟囱、两根细桅杆和修长舰体，体现了“帕拉达”号与“狄安娜”号的共同外形。贝尔维尔锅炉为三台主机供汽，主机驱动三副螺旋桨。",
        "weaponSlug": null,
        "refs": [
          1,
          3
        ],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Pallada1897-1905.jpg"
        ]
      },
      {
        "id": "masts",
        "label": "桅杆与平台",
        "x": 65,
        "y": 27,
        "text": "两根带横桁的细桅杆分立于三座烟囱的两侧。这是20世纪初、日本打捞并改名之前的“帕拉达”号外形。",
        "weaponSlug": null,
        "refs": [],
        "sourceUrls": [
          "https://commons.wikimedia.org/wiki/File:Pallada1897-1905.jpg"
        ]
      },
      {
        "id": "hull-protection",
        "label": "舰内装甲甲板",
        "x": 56,
        "y": 69,
        "text": "装甲甲板位于舰体内部，中部近乎水平，两侧斜向下接近舷侧，保护动力装置及弹药库；舰体没有连续的舷侧装甲带。这就是防护巡洋舰这一称呼的由来。",
        "weaponSlug": null,
        "refs": [
          1,
          3
        ],
        "sourceUrls": []
      }
    ],
    "photoFile": "/images/hardware/pallada-1.webp"
  },
  {
    "shipSlug": "diana",
    "period": "武器数据区分原始配置与1904年七月海战时的配置。照片为1903年以前、喀琅施塔得小锚地的“狄安娜”号。",
