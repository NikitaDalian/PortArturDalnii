---
import Base from '../../layouts/Base.astro';
import Coast from '../../components/Coast.astro';
import Crumbs from '../../components/Crumbs.astro';
import PeopleBrowser from '../../components/people/PeopleBrowser.astro';
import MentionCloud from '../../components/people/MentionCloud.astro';
import { href, people, plural } from '../../lib/data';
import { mentionedNames } from '../../components/people/relations';

const n = people.length;
const extra = mentionedNames().length;
const lead = 'Строители городов, военные, жители и авторы воспоминаний. Биографии и связи помогают увидеть одну историю с разных сторон.';
---
<Base searchable={false} title="Люди Порт-Артура и Дальнего" description={`${n} ${plural(n, 'персона', 'персоны', 'персон')} из истории Порт-Артура и Дальнего: биографии, цитаты, заметки канала, места и книги.`} section="people">
  <section class="dark lica-hero page-top">
    <div class="container">
      <div class="stack lica-hero__head" style="--stack-gap:16px">
        <Crumbs items={[{ label: 'Главная', href: href.home() }, { label: 'Люди' }]} />
        <p class="eyebrow eyebrow--accent">Россия · Япония · Китай</p>
        <h1 class="h1">Люди Порт-Артура и Дальнего</h1>
        <p class="lead">{lead}</p>
        <p class="meta">{n} {plural(n, 'биография', 'биографии', 'биографий')} и {extra} {plural(extra, 'краткая справка', 'краткие справки', 'кратких справок')}</p>
      </div>
      <PeopleBrowser />
    </div>
    <Coast />
  </section>

  <section class="section" aria-labelledby="mentioned">
    <div class="container">
      <div class="section-head">
        <div class="stack" style="--stack-gap:10px">
          <h2 class="h2" id="mentioned">Краткие справки</h2>
          <p class="lead">Кто эти люди и как они связаны с историей. Имя открывает справку с источниками; число показывает количество связанных заметок.</p>
        </div>
      </div>
      <MentionCloud />
    </div>
  </section>
</Base>

<style>
  .lica-hero__head { margin-bottom: 32px; }
  .lica-hero .container { padding-bottom: clamp(24px, 4vw, 48px); }
</style>
