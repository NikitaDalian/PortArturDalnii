---
import Base from '../../layouts/Base.astro';
import Coast from '../../components/Coast.astro';
import Crumbs from '../../components/Crumbs.astro';
import PeopleBrowser from '../../components/people/PeopleBrowser.astro';
import MentionCloud from '../../components/people/MentionCloud.astro';
import { href, people, plural } from '../../lib/data';
import { mentionedNames } from '../../components/people/relations';

const n = people.length;
const extra = mentionedNames().length;
const lead = 'Русские, японцы, китайцы и один британский лейтенант: строители городов, участники обороны и осады, авторы мемуаров и исследований.';
---
<Base searchable={false} title="Лица Порт-Артура" description={`${n} ${plural(n, 'персона', 'персоны', 'персон')} из истории Порт-Артура и Дальнего: биографии, цитаты, заметки канала, места и книги.`} section="people">
  <section class="dark lica-hero page-top">
    <div class="container">
      <div class="stack lica-hero__head" style="--stack-gap:16px">
        <Crumbs items={[{ label: 'Главная', href: href.home() }, { label: 'Лица' }]} />
        <p class="eyebrow eyebrow--accent">Россия · Япония · Китай</p>
        <h1 class="h1">Лица Порт-Артура</h1>
        <p class="lead">{lead}</p>
        <p class="meta">{n} {plural(n, 'персона', 'персоны', 'персон')} с отдельными страницами и ещё {extra} {plural(extra, 'имя', 'имени', 'имён')} в заметках</p>
      </div>
      <PeopleBrowser />
    </div>
    <Coast />
  </section>

  <section class="section" aria-labelledby="mentioned">
    <div class="container">
      <div class="section-head">
        <div class="stack" style="--stack-gap:10px">
          <h2 class="h2" id="mentioned">Ещё упоминаются в заметках</h2>
          <p class="lead">Отдельной страницы у них пока нет. Имя ведёт в поиск по сайту, число показывает, в скольких заметках оно встречается.</p>
        </div>
      </div>
      <MentionCloud />
    </div>
  </section>
</Base>

<style>
  .lica-hero__head { margin-bottom: 32px; }
  .lica-hero .container { padding-bottom: clamp(24px, 4vw, 48px); }
</style>
