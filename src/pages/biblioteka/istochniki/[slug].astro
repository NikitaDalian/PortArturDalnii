---
import Base from '../../../layouts/Base.astro';
import Coast from '../../../components/Coast.astro';
import Crumbs from '../../../components/Crumbs.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import TgButton from '../../../components/TgButton.astro';
import Related from '../../../components/Related.astro';
import SourceCard from '../../../components/library/SourceCard.astro';
import { sourceKindLabel, peopleOf, similarSources } from '../../../components/library/labels';
import { sources, href, img, focusStyle, articlesOf, type Source } from '../../../lib/data';

export function getStaticPaths() {
  return sources.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
interface Props { s: Source }
const { s } = Astro.props;

const pic = img(s.image);
const kind = sourceKindLabel(s.kind);
const notes = articlesOf(s.articles ?? []);
const firstPost = s.posts?.[0] ?? null;
const people = peopleOf(s.articles ?? []);
const places = [...new Set(notes.flatMap((a) => a.places ?? []))];
const similar = similarSources(s, sources);
const hostOf = (u: string) => {
  try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return null; }
};
const host = s.url ? hostOf(s.url) : null;
const description = s.annotation ? s.annotation.slice(0, 180) : `${kind}: ${s.title}`;
---
<Base title={s.title} description={description} image={pic} section="library">
  <section class="dark src-hero page-top" data-pagefind-filter="type:Книги">
    <div class="container src-hero__inner page-top__inner" class:list={[{ 'has-img': pic }]}>
      <div class="src-hero__text stack" style="--stack-gap:16px">
        <Crumbs items={[{ label: 'Главная', href: href.home() }, { label: 'Библиотека', href: href.library() }, { label: 'Источники', href: `${href.library()}#istochniki` }, { label: s.title }]} />
        <p class="eyebrow eyebrow--accent">{kind}</p>
        <h1 class="h1 src-hero__title" data-pagefind-meta="title">{s.title}</h1>
        <span hidden data-pagefind-meta={`sub:${kind}${s.author ? ' · ' + s.author : ''}`}></span>
        {s.author && <p class="lead src-hero__author">{s.author}</p>}
        {s.url && (
          <div class="cluster" style="--cluster-gap:12px">
            <a class="btn btn--primary" href={s.url} target="_blank" rel="noopener">
              Открыть источник
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg>
            </a>
            {host && <span class="meta">{host}</span>}
          </div>
        )}
      </div>
      {pic && (
        <figure class="src-hero__fig">
          <img src={pic} alt={s.title} transition:name={`source-${s.slug}`} style={focusStyle(s.image)} loading="eager" decoding="async" data-pagefind-meta="image[src], image_alt[alt]" />
        </figure>
      )}
    </div>
    <Coast />
  </section>

  <section class="section section--tight">
    <div class="container split">
      <div class="stack" style="--stack-gap:24px">
        {s.annotation && (
          <div class="stack" style="--stack-gap:12px">
            <h2 class="h3">Об источнике</h2>
            <div class="prose"><p>{s.annotation}</p></div>
          </div>
        )}
        <div class="cluster" style="--cluster-gap:12px">
          {s.url && (
            <a class="btn btn--outline btn--sm" href={s.url} target="_blank" rel="noopener">
              Открыть источник
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg>
            </a>
          )}
          {firstPost && <TgButton id={firstPost} label="Пост в Telegram" variant="outline" />}
        </div>
      </div>
      {(people.length > 0 || places.length > 0) && (
        <aside class="panel src-aside" aria-label="Связанные люди и места">
          <Related people={people} places={places} />
        </aside>
      )}
    </div>
  </section>

  {notes.length > 0 && (
    <section class="section section--tight paper src-sec" aria-labelledby="notes-h">
      <div class="container">
        <div class="section-head">
          <h2 class="h2" id="notes-h">Заметки об источнике</h2>
        </div>
        <div class="row-list">
          {notes.map((a) => <ArticleCard a={a} variant="row" showSummary />)}
        </div>
      </div>
    </section>
  )}

  {similar.length > 0 && (
    <section class="section section--tight" aria-labelledby="similar-h">
      <div class="container">
        <div class="section-head">
          <h2 class="h2" id="similar-h">Похожие источники</h2>
          <a class="link" href={`${href.library()}#istochniki`}>Все источники</a>
        </div>
        <div class="grid" style="--min:250px; --grid-gap:28px 24px">
          {similar.map((x) => <SourceCard s={x} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .src-hero__inner { display: flex; flex-wrap: wrap; gap: 32px 48px; align-items: flex-end; }
  .src-hero__text { flex: 1 1 520px; min-width: 0; }
  .src-hero__title { overflow-wrap: anywhere; hyphens: auto; }
  .src-hero__author { color: #fff; font-weight: 600; }
  .src-hero__fig { flex: 0 1 460px; min-width: 0; }
  .src-hero__fig img { width: 100%; max-height: 440px; object-fit: contain; object-position: left bottom; }
  .src-aside { flex: 0 1 380px !important; }
  .src-sec { border-top: 1px solid var(--line); }
</style>
