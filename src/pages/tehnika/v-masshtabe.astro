---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import LinkedText from '../../components/LinkedText.astro';
import FleetFilters from '../../components/hardware/FleetFilters.astro';
import SourceRefs from '../../components/hardware/SourceRefs.astro';
import { fleetOverview as overview } from '../../lib/fleet';
import { hardwareBySlug } from '../../lib/hardware';
import { href, articleBySlug } from '../../lib/data';
import { mentionContext } from '../../lib/mentions';
import { intlLocale, assetUrl } from '../../i18n/locale';

const rows=overview.ships.map(row=>({...row,ship:hardwareBySlug.get(row.shipSlug)!})).filter(row=>row.ship).sort((a,b)=>(b.lengthOverallM??-1)-(a.lengthOverallM??-1));
const maxLength=Math.max(150,...rows.map(row=>Math.ceil((row.lengthOverallM??0)/50)*50));
const ticks=Array.from({length:maxLength/50+1},(_,i)=>i*50);
const fmt=(value:number|null)=>value===null?'—':new Intl.NumberFormat(intlLocale,{maximumFractionDigits:2}).format(value);
const reading=overview.relatedNotes.map(slug=>articleBySlug.get(slug)).filter(Boolean);
const context=mentionContext();
const featured=hardwareBySlug.get('retvizan')!;
---
<Base title={overview.title} description={overview.dek} section="hardware">
  <header class="fleet-head">
    <div class="container">
      <Crumbs items={[{label:'Главная',href:href.home()},{label:'Корабли и вооружение',href:href.hardwareIndex()}]} />
      <div class="fleet-cover">
        <div><p class="eyebrow">Визуальный обзор</p><h1 data-pagefind-meta="title">{overview.title}</h1><p class="lead">{overview.dek}</p></div>
        <figure><img src={assetUrl('images/fleet/retvizan.svg')} alt="" width="1200" height="260" fetchpriority="high"/><figcaption><a href={href.hardware(featured.slug)}>{featured.shortName}</a><span>{featured.category}</span></figcaption></figure>
      </div>
      <span hidden data-pagefind-filter="type:Корабли"></span>
    </div>
  </header>
  <div class="container fleet-intro prose">
    {overview.intro.slice(0,1).map(text=><p><LinkedText text={text} context={context}/></p>)}
    {overview.intro.length>1&&<details class="fleet-guide"><summary>Как читать сравнение</summary>{overview.intro.slice(1).map(text=><p><LinkedText text={text} context={context}/></p>)}</details>}
  </div>
  <section class="container fleet-comparison" aria-labelledby="comparison-title" data-fleet-comparison>
    <div class="fleet-heading"><h2 id="comparison-title">Один масштаб — разные задачи</h2><a class="text-link" href={href.hardwareIndex()}>Подробные истории кораблей</a></div>
    <p class="fleet-explanation">У каждого корабля свой облик. Сравните трубы, мачты и башни, затем откройте фотографию и его историю. Профили стилизованы по архивным снимкам; в общем масштабе показана длина корпуса, мелкие детали упрощены.</p>
    <p class="fleet-art-note">Цвета условны; это иллюстрации, а не технические чертежи.</p>
    <FleetFilters />
    <form class="fleet-controls" onsubmit="return false" data-pagefind-ignore>
      <fieldset><legend>Вид сравнения</legend><div class="fleet-view"><button type="button" data-view="diagram" aria-pressed="true">Профили кораблей</button><button type="button" data-view="table" aria-pressed="false">Таблица</button></div></fieldset>
    </form>
    <p class="meta fleet-count" aria-live="polite"><span>Показано кораблей:</span> <b data-fleet-count>{rows.length}</b></p>
    <div class="fleet-diagram" data-fleet-view="diagram">
      <div class="fleet-axis" aria-hidden="true"><span></span><div>{ticks.map(tick=><span style={`left:${tick/maxLength*100}%`}>{tick} м</span>)}</div><span></span></div>
      <ol class="fleet-rows">
        {rows.map(row=><li class={`fleet-row fleet-profile-${row.profile}`} data-fleet-record data-group={row.group}>
          <div class="fleet-name"><h3><LinkedText text={row.ship.shortName} context={mentionContext([],[`ship/${row.shipSlug}`])}/></h3><p>{row.ship.category}</p></div>
          <div class:list={['fleet-track',{'fleet-track-unscaled':row.lengthOverallM===null}]} style={`--grid-step:${50/maxLength*100}%`}>
            <img class="fleet-profile" src={assetUrl(row.illustration.file)} alt={row.illustration.note} width="1200" height="260" loading="lazy" decoding="async" style={row.lengthOverallM!==null?`width:${row.lengthOverallM/maxLength*1200/(row.illustration.hullEnd-row.illustration.hullStart)*100}%;margin-left:${-row.lengthOverallM/maxLength*row.illustration.hullStart/(row.illustration.hullEnd-row.illustration.hullStart)*100}%`:'width:88%'} />
            {row.lengthOverallM===null&&<span class="fleet-unscaled-label">Вне масштаба</span>}
          </div>
          <p class="fleet-length"><span class="sr-only">Наибольшая длина:</span> {fmt(row.lengthOverallM)}{row.lengthOverallM!==null&&<span> м</span>}</p>
          <p class="fleet-visual-note">{row.illustration.note}</p>
          <details class="fleet-story">
            <summary>Фотография и история</summary>
            <div class="fleet-story-content">
              {row.ship.images[0]&&<figure><img src={assetUrl(row.ship.images[0].file)} alt={row.ship.images[0].alt} width={row.ship.images[0].width} height={row.ship.images[0].height} loading="lazy" decoding="async"/><figcaption>{row.ship.images[0].caption} <a href={row.ship.images[0].sourceUrl} target="_blank" rel="noopener">{row.ship.images[0].credit}</a> · {row.ship.images[0].license}</figcaption></figure>}
              <div><p>{row.ship.summary}</p><a class="fleet-read" href={href.hardware(row.shipSlug)}>Читать историю корабля</a><details class="fleet-evidence"><summary>Данные и источник</summary><p>{row.measurementNote}</p><ul>{row.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener">{source.title}</a><span>{source.locator}</span></li>)}</ul><p>Фотографии</p><ul>{row.illustration.sourceUrls.map(url=><li><a href={url} target="_blank" rel="noopener">{row.ship.shortName}</a></li>)}</ul></details></div>
            </div>
          </details>
        </li>)}
      </ol>
    </div>
    <div class="fleet-table-wrap" data-fleet-view="table" hidden tabindex="0" role="region" aria-label="Таблица сравнения кораблей">
      <table>
        <caption>Сравнение по длине корпуса</caption>
        <thead><tr><th scope="col">Корабль</th><th scope="col">Длина, м</th><th scope="col">Тип</th><th scope="col">Источник</th></tr></thead>
        <tbody>{rows.map(row=><tr data-fleet-record data-group={row.group}><th scope="row"><a href={href.hardware(row.shipSlug)}>{row.ship.shortName}</a></th><td>{fmt(row.lengthOverallM)}</td><td>{row.ship.category}</td><td>{row.sources[0]&&<a href={row.sources[0].url} target="_blank" rel="noopener" title={row.sources[0].title}>Источник</a>}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="fleet-caveat">Здесь представлены корабли, о которых уже есть подробные страницы. Полный состав флотов был значительно шире. Условия измерения раскрыты в данных к каждой строке; прочерк означает, что сопоставимая длина не подтверждена.</p>
  </section>
  <article class="container fleet-reading">
    {overview.sections.map(section=><section id={section.id} class="fleet-story-section"><h2>{section.title}</h2><div class="prose">{section.paragraphs.map(text=><p><LinkedText text={text} context={context}/></p>)}</div><SourceRefs refs={section.refs}/></section>)}
    {reading.length>0&&<nav class="fleet-story-section fleet-related" aria-label="Продолжить чтение"><h2>Продолжить чтение</h2>{reading.map(note=><a href={href.note(note!.slug)}>{note!.title}</a>)}</nav>}
    <section class="fleet-story-section fleet-sources" id="sources"><h2>Источники</h2><ol>{overview.sources.map(source=><li id={`source-${source.id}`}><a href={source.url} target="_blank" rel="noopener">{source.title}</a><p>{source.author} · {source.date}</p><p>{source.locator}</p><p>{source.note}</p></li>)}</ol></section>
  </article>
</Base>
<style>
  .fleet-head{padding:32px 0 48px}.eyebrow{margin-top:30px;color:var(--steel)}h1{font-size:clamp(36px,5vw,68px);line-height:1.12;margin:16px 0 24px}.lead{max-width:70ch;color:var(--mist);font-size:20px;line-height:1.7}
  .fleet-intro{max-width:820px;padding-block:38px 44px;font-size:20px;line-height:1.85}.fleet-guide{margin-top:16px}.fleet-guide summary{font-size:15px;text-decoration:underline;text-underline-offset:4px;cursor:pointer;min-height:36px}.fleet-guide p{margin-top:16px}.fleet-comparison{padding-bottom:48px}.fleet-heading{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:16px}h2{font-size:clamp(26px,3vw,36px);line-height:1.25}.fleet-explanation{max-width:78ch;font-size:17px;line-height:1.75;margin:20px 0 28px;color:var(--ink-2)}
  .fleet-controls{display:flex;flex-wrap:wrap;gap:20px 36px;align-items:end;border-block:1px solid var(--line);padding:20px 0}.fleet-controls label{display:grid;gap:8px;font-size:15px}.fleet-controls select{min-height:46px;max-width:100%;padding:10px 34px 10px 12px;border:1px solid var(--line-2);background:var(--paper);color:var(--ink);font:inherit}.fleet-controls fieldset{padding:0;border:0;min-width:0}.fleet-controls legend{font-size:15px;margin-bottom:8px}.fleet-view{display:flex;gap:4px}.fleet-view button{min-height:46px;padding:10px 22px;border:1px solid var(--line-2);background:var(--paper);font:inherit;color:var(--ink);cursor:pointer}.fleet-view button[aria-pressed=true]{background:var(--navy);color:white;border-color:var(--navy)}.fleet-controls :focus-visible,.fleet-table-wrap:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.fleet-count{margin-block:18px}
  .fleet-axis,.fleet-row{display:grid;grid-template-columns:180px minmax(0,1fr) 80px;column-gap:24px}.fleet-axis{padding-block:18px 12px}.fleet-axis>div{position:relative;height:24px;border-bottom:1px solid var(--line-2)}.fleet-axis>div span{position:absolute;top:0;transform:translateX(-50%);font-size:12px;white-space:nowrap;color:var(--ink-2)}.fleet-axis>div span:first-child{transform:none}.fleet-axis>div span:last-child{transform:translateX(-100%)}
  .fleet-rows{list-style:none;padding:0;margin:0}.fleet-row{align-items:center;padding:22px 0 16px;border-bottom:1px solid var(--line)}.fleet-name h3{font-size:23px;line-height:1.2;margin:0 0 7px}.fleet-name p{font-size:13px;color:var(--ink-2);line-height:1.5}.fleet-track{min-height:150px;position:relative;display:flex;align-items:center;background:repeating-linear-gradient(to right,var(--line) 0 1px,transparent 1px var(--grid-step));border-right:1px solid var(--line);min-width:0}.fleet-length{font-weight:700;font-variant-numeric:tabular-nums;font-size:18px;white-space:nowrap;text-align:right}.fleet-length span:not(.sr-only){font-weight:400;font-size:14px}
  .fleet-evidence{font-size:14px;line-height:1.7;color:var(--ink-2);margin-top:6px}.fleet-evidence summary{cursor:pointer;width:fit-content;min-height:30px;padding-block:4px;text-decoration:underline;text-underline-offset:3px}.fleet-evidence p{margin:12px 0}.fleet-evidence ul{margin:0;padding-left:18px}.fleet-evidence li{margin:10px 0}.fleet-evidence li span{display:block}.fleet-evidence a{overflow-wrap:anywhere;text-decoration:underline}
  .fleet-table-wrap{max-width:100%;overflow-x:auto;background:var(--paper)}table{border-collapse:collapse;width:100%;font-size:16px;line-height:1.6}caption{text-align:left;padding:20px;font-weight:650}th,td{padding:16px 20px;border-bottom:1px solid var(--line);text-align:left}thead th{font-size:14px;background:var(--ice)}tbody th{min-width:160px}td:nth-child(2),td:nth-child(3){white-space:nowrap;font-variant-numeric:tabular-nums}table a{text-decoration:underline}.fleet-caveat{max-width:90ch;margin-top:24px;padding-left:18px;border-left:3px solid var(--line-2);font-size:15px;line-height:1.75;color:var(--ink-2)}
  .fleet-reading{max-width:820px;padding-bottom:72px}.fleet-story-section{margin-top:42px;scroll-margin-top:100px}.fleet-story-section h2{margin-bottom:22px}.fleet-story-section .prose{font-size:20px;line-height:1.85}.fleet-related{display:flex;flex-direction:column;gap:18px}.fleet-related a,.fleet-sources a{text-decoration:underline;line-height:1.65}.fleet-sources{border-top:1px solid var(--line);padding-top:32px;font-size:15px;line-height:1.7}.fleet-sources ol{padding-left:22px}.fleet-sources li{margin-bottom:24px;scroll-margin-top:100px}.fleet-sources p{margin-top:6px}
  .fleet-profile{height:auto;display:block;object-fit:contain;align-self:end;margin-bottom:8px}
  .fleet-visual-note{grid-column:2/4;font-size:14px;line-height:1.65;color:var(--ink-2);margin-top:8px;max-width:70ch}.fleet-art-note{font-size:14px;line-height:1.6;color:var(--ink-2);margin-top:-14px;margin-bottom:24px}
  @media(max-width:760px){.fleet-visual-note{grid-column:1/3}}
  .fleet-head{background:var(--ice)}.fleet-cover{display:grid;grid-template-columns:minmax(280px,0.8fr) minmax(0,1.2fr);gap:42px;align-items:center}.fleet-cover .lead{color:var(--ink-2);font-size:18px;line-height:1.7}.fleet-cover .eyebrow{color:var(--sea)}.fleet-cover figure{margin:35px 0 0}.fleet-cover img{display:block;width:100%;height:auto}.fleet-cover figcaption{display:flex;justify-content:space-between;gap:16px;border-top:1px solid var(--line-2);padding-top:14px;font-size:15px}.fleet-cover figcaption a{text-decoration:underline;text-underline-offset:4px}.fleet-cover figcaption span{font-size:12px;color:var(--ink-2);text-align:right}
  @media(max-width:760px){.fleet-cover{grid-template-columns:1fr;gap:12px}.fleet-cover h1{font-size:42px}.fleet-cover figure{margin:0}.fleet-cover .eyebrow{margin-top:22px}.fleet-head{padding-bottom:28px}}
  .fleet-track-unscaled{background:none;border-right:none}.fleet-unscaled-label{position:absolute;right:0;top:0;font-size:12px;color:var(--ink-2)}
  .fleet-story{grid-column:2/4;margin-top:10px;font-size:15px;line-height:1.7}.fleet-story>summary{cursor:pointer;width:fit-content;min-height:38px;padding:6px 0;color:var(--sea);text-decoration:underline;text-underline-offset:4px}
  .fleet-story-content{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:28px;padding-block:20px 12px}.fleet-story figure{margin:0}.fleet-story img{width:100%;height:auto;max-height:340px;object-fit:contain;background:var(--frost)}.fleet-story figcaption{font-size:12px;line-height:1.6;color:var(--ink-2);margin-top:9px}.fleet-story figcaption a{text-decoration:underline}.fleet-read{display:inline-block;margin:18px 0;text-decoration:underline;text-underline-offset:4px;font-weight:600}
  @media(max-width:760px){.fleet-story{grid-column:1/3}.fleet-story-content{grid-template-columns:1fr;gap:18px}.fleet-track{min-height:80px}.fleet-profile{margin-bottom:4px}.fleet-name{margin-top:8px}}
  [hidden]{display:none!important}
  @media(max-width:760px){.fleet-axis{grid-template-columns:minmax(0,1fr) 75px;gap:14px}.fleet-axis>span:first-child{display:none}.fleet-row{grid-template-columns:minmax(0,1fr) 75px;gap:12px 14px}.fleet-name{grid-column:1/3;display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 14px}.fleet-name h3{margin:0;font-size:22px}.fleet-name p{margin:0}.fleet-evidence{grid-column:1/3;margin-top:0}.fleet-track{min-height:76px}.fleet-row{padding-block:18px 12px}.fleet-length{font-size:16px}.fleet-heading{display:block}.fleet-heading>a{display:inline-block;margin-top:14px}.fleet-controls label,.fleet-controls select{width:100%}.fleet-intro{font-size:18px}.fleet-story-section .prose{font-size:18px}}
  @media print{.fleet-controls,.fleet-count,.fleet-evidence{display:none}.fleet-row{break-inside:avoid}.fleet-head{background:white;color:var(--ink)}.lead,.eyebrow{color:var(--ink-2)}h2,h3{break-after:avoid}}
</style>
<script>
  function initFleetComparison(){
    const root=document.querySelector<HTMLElement>('[data-fleet-comparison]');if(!root||root.dataset.ready)return;root.dataset.ready='true';
    const filters=[...root.querySelectorAll<HTMLButtonElement>('[data-fleet-filter]')];
    const params=new URLSearchParams(location.search);
    const requested=params.get('fleet')??'port-arthur';
    let group=filters.some(button=>button.dataset.fleetFilter===requested)?requested:'port-arthur';
    let view=params.get('view')==='table'?'table':'diagram';
    function update(){
      root!.querySelectorAll<HTMLElement>('[data-fleet-record]').forEach(row=>row.hidden=!!group&&row.dataset.group!==group);
      filters.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.fleetFilter===group)));
      root!.querySelector('[data-fleet-count]')!.textContent=String(root!.querySelectorAll('.fleet-row:not([hidden])').length);
      root!.querySelectorAll<HTMLElement>('[data-fleet-view]').forEach(panel=>panel.hidden=panel.dataset.fleetView!==view);
      root!.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.view===view)));
      const params=new URLSearchParams();if(group!=='port-arthur')params.set('fleet',group);if(view==='table')params.set('view',view);
      history.replaceState(history.state,'',location.pathname+(params.size?'?'+params.toString():'')+location.hash);
    }
    filters.forEach(button=>button.addEventListener('click',()=>{group=button.dataset.fleetFilter!;update();}));root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button=>button.addEventListener('click',()=>{view=button.dataset.view!;update();}));update();
  }
  document.addEventListener('astro:page-load',initFleetComparison);
</script>
