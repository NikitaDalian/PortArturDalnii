---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ArchiveFigure from '../../components/hardware/ArchiveFigure.astro';
import LinkedText from '../../components/LinkedText.astro';
import FleetFilters from '../../components/hardware/FleetFilters.astro';
import SourceRefs from '../../components/hardware/SourceRefs.astro';
import { fleetOverview as overview } from '../../lib/fleet';
import { hardwareBySlug, subjectImage } from '../../lib/hardware';
import { href, articleBySlug } from '../../lib/data';
import { mentionContext } from '../../lib/mentions';
import { intlLocale, locale, assetUrl } from '../../i18n/locale';

const rows=overview.ships.map(row=>({...row,ship:hardwareBySlug.get(row.shipSlug)!})).filter(row=>row.ship).sort((a,b)=>(b.lengthOverallM??-1)-(a.lengthOverallM??-1));
const maxLength=Math.max(150,...rows.map(row=>Math.ceil((row.lengthOverallM??0)/50)*50));
const ticks=Array.from({length:maxLength/50+1},(_,i)=>i*50);
const fmt=(value:number|null)=>value===null?'—':new Intl.NumberFormat(intlLocale,{maximumFractionDigits:2}).format(value);
const reading=overview.relatedNotes.map(slug=>articleBySlug.get(slug)).filter(Boolean);
const context=mentionContext();
const missingPhoto = {ru:'Фотография судна пока не установлена.',en:'A photograph of the vessel has yet to be identified.',zh:'尚未确认该船的照片。'}[locale];
---
<Base title={overview.title} description={overview.dek} section="hardware">
  <PageHero title={overview.title} lead={overview.dek} crumbs={[{label:'Главная',href:href.home()},{label:'Корабли и вооружение',href:href.hardwareIndex()}]} />
  <span hidden data-pagefind-filter="type:Корабли"></span>
  <section class="container fleet-comparison" aria-labelledby="comparison-title" data-fleet-comparison>
    <div class="fleet-heading"><h2 id="comparison-title">Сравните корабли по длине</h2><a class="text-link" href={href.hardwareIndex()}>Подробные истории кораблей</a></div>
    <p class="fleet-explanation">Линейки показывают длину корпуса в общем масштабе. Архивные фотографии и рисунки сопровождаются подписями об их происхождении.</p>
    <FleetFilters />
    <form class="fleet-controls" onsubmit="return false" data-pagefind-ignore>
      <fieldset><legend>Вид сравнения</legend><div class="fleet-view"><button type="button" data-view="diagram" aria-pressed="true">Фотографии и размеры</button><button type="button" data-view="table" aria-pressed="false">Таблица</button></div></fieldset>
    </form>
    <p class="meta fleet-count" aria-live="polite"><span>Показано кораблей:</span> <b data-fleet-count>{rows.length}</b></p>
    <div class="fleet-diagram" data-fleet-view="diagram">
      <ol class="fleet-rows">
        {rows.map(row=><li class={`fleet-row fleet-profile-${row.profile}`} data-fleet-record data-group={row.group}>
          <div class="fleet-name"><h3><LinkedText text={row.ship.shortName} context={mentionContext([],[`ship/${row.shipSlug}`])}/></h3><p>{row.ship.category}</p></div>
          <div class="fleet-photo">{(() => {
            const picture = subjectImage(row.ship, row.shipSlug === 'poltava' ? 1 : 0);
            return picture ? <ArchiveFigure picture={picture} destination={href.hardware(row.shipSlug)} destinationLabel="Читать историю корабля" /> : <p class="meta">{missingPhoto}</p>;
          })()}</div>
          <div class="fleet-measure">
            {row.lengthOverallM!==null ? <>
              <div class="fleet-ruler" aria-hidden="true">{ticks.map(tick=><span style={`left:${tick/maxLength*100}%`}>{tick} м</span>)}</div>
              <div class="fleet-bar" style={`width:${row.lengthOverallM/maxLength*100}%`} aria-hidden="true"></div>
              <p class="fleet-length"><span>Наибольшая длина:</span> <strong>{fmt(row.lengthOverallM)} м</strong></p>
            </> : <p class="fleet-unknown">Сопоставимая длина не подтверждена — вне шкалы.</p>}
          </div>
          <details class="fleet-story">
            <summary>История и источники измерения</summary>
            <div class="fleet-story-content">
              <div><p>{row.ship.summary}</p><a class="fleet-read" href={href.hardware(row.shipSlug)}>Читать историю корабля</a><details class="fleet-evidence"><summary>Данные и источник</summary><p>{row.measurementNote}</p><ul>{row.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener">{source.title}</a><span>{source.locator}</span></li>)}</ul></details></div>
            </div>
          </details>
        </li>)}
      </ol>
    </div>
    <div class="fleet-table-wrap" data-fleet-view="table" hidden tabindex="0" role="region" aria-label="Таблица сравнения кораблей">
      <table>
        <caption>Сравнение по длине корпуса</caption>
        <thead><tr><th scope="col">Корабль</th><th scope="col">Длина, м</th><th scope="col">Тип</th><th scope="col">Источник</th></tr></thead>
        <tbody>{rows.map(row=><tr data-fleet-record data-group={row.group}><th scope="row"><a href={href.hardware(row.shipSlug)}>{row.ship.shortName}</a></th><td>{fmt(row.lengthOverallM)}</td><td>{row.ship.category}</td><td>{row.sources[0]&&<a href={row.sources[0].url} target="_blank" rel="noopener" title={row.sources[0].title}>Источник</a>}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="fleet-caveat">Здесь представлены корабли, о которых уже есть подробные страницы. Полный состав флотов был значительно шире. Условия измерения раскрыты в данных к каждой строке; прочерк означает, что сопоставимая длина не подтверждена.</p>
  </section>
  <article class="container fleet-reading">
    <section class="fleet-story-section"><h2>Как читать сравнение</h2><div class="prose">{overview.intro.map(text=><p><LinkedText text={text} context={context}/></p>)}</div></section>
    {overview.sections.map(section=><section id={section.id} class="fleet-story-section"><h2>{section.title}</h2><div class="prose">{section.paragraphs.map(text=><p><LinkedText text={text} context={context}/></p>)}</div><SourceRefs refs={section.refs}/></section>)}
    {reading.length>0&&<nav class="fleet-story-section fleet-related" aria-label="Продолжить чтение"><h2>Продолжить чтение</h2>{reading.map(note=><a href={href.note(note!.slug)}>{note!.title}</a>)}</nav>}
    <section class="fleet-story-section fleet-sources" id="sources"><h2>Источники</h2><ol>{overview.sources.map(source=><li id={`source-${source.id}`}><a href={source.url} target="_blank" rel="noopener">{source.title}</a><p>{source.author} · {source.date}</p><p>{source.locator}</p><p>{source.note}</p></li>)}</ol></section>
  </article>
</Base>
<style>
  .fleet-comparison{padding-block:32px 56px}.fleet-heading{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:12px 24px}h2{font-size:clamp(26px,3vw,36px);line-height:1.25}.fleet-explanation{max-width:75ch;font-size:17px;line-height:1.7;margin:18px 0 24px;color:var(--ink-2)}
  .fleet-controls{border-block:1px solid var(--line);padding:16px 0}.fleet-controls fieldset{border:0;padding:0}.fleet-controls legend{font-size:14px;margin-bottom:8px}.fleet-view{display:flex;gap:6px;flex-wrap:wrap}.fleet-view button{min-height:44px;padding:10px 18px;border:1px solid var(--line-2);background:var(--paper);font:inherit;color:var(--ink);cursor:pointer}.fleet-view button[aria-pressed=true]{background:var(--navy);color:white}.fleet-count{margin-block:18px}
  .fleet-rows{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:40px 48px}.fleet-row{min-width:0;border-bottom:1px solid var(--line);padding-bottom:24px;display:flex;flex-direction:column}.fleet-name{margin-bottom:16px}.fleet-name h3{font-size:28px;line-height:1.2;margin-bottom:7px}.fleet-name p{font-size:14px;color:var(--ink-2)}
  .fleet-photo :global(.archive-figure){margin:0}.fleet-photo :global(.archive-figure img){width:100%;height:300px;object-fit:contain;background:var(--frost)}.fleet-photo :global(figcaption){font-size:13px;line-height:1.6}.fleet-measure{margin-top:auto;padding-top:30px}.fleet-ruler{position:relative;height:25px;border-bottom:1px solid var(--line-2);margin-bottom:8px}.fleet-ruler span{position:absolute;transform:translateX(-50%);font-size:12px;color:var(--ink-2)}.fleet-ruler span:first-child{transform:none}.fleet-ruler span:last-child{transform:translateX(-100%)}.fleet-bar{height:10px;background:var(--sea);border-inline:2px solid var(--navy)}.fleet-length{display:flex;gap:12px;justify-content:space-between;align-items:baseline;margin-top:12px;font-size:14px;color:var(--ink-2)}.fleet-length strong{font-size:24px;color:var(--ink);font-variant-numeric:tabular-nums}.fleet-unknown{padding:25px 0;font-size:15px;color:var(--ink-2);border-block:1px dashed var(--line-2)}
  .fleet-story{margin-top:18px;font-size:16px;line-height:1.7}.fleet-story>summary,.fleet-evidence>summary{cursor:pointer;text-decoration:underline;text-underline-offset:4px;min-height:44px;padding-block:8px}.fleet-story-content{padding-top:12px}.fleet-read{display:inline-block;margin:14px 0;text-decoration:underline}.fleet-evidence{font-size:14px;color:var(--ink-2)}.fleet-evidence li{margin:12px 0}.fleet-evidence li span{display:block}.fleet-evidence a,.fleet-sources a{overflow-wrap:anywhere;text-decoration:underline}
  .fleet-table-wrap{overflow-x:auto;background:var(--paper)}table{border-collapse:collapse;width:100%;font-size:16px;line-height:1.6}caption{text-align:left;padding:20px;font-weight:650}th,td{padding:16px 20px;border-bottom:1px solid var(--line);text-align:left}thead th{background:var(--frost)}tbody th{min-width:150px}table a{text-decoration:underline}.fleet-caveat{max-width:85ch;margin-top:32px;padding-left:18px;border-left:3px solid var(--line-2);font-size:15px;line-height:1.75;color:var(--ink-2)}
  .fleet-reading{max-width:820px;padding-bottom:72px}.fleet-story-section{margin-top:42px;scroll-margin-top:120px}.fleet-story-section h2{margin-bottom:22px}.prose{font-size:20px;line-height:1.85}.fleet-related{display:flex;flex-direction:column;gap:18px}.fleet-related a{text-decoration:underline}.fleet-sources{font-size:15px;line-height:1.7;overflow-wrap:anywhere}.fleet-sources li{margin-bottom:24px}.fleet-sources p{margin-top:6px}[hidden]{display:none!important}
  @media(max-width:760px){.fleet-rows{grid-template-columns:1fr;gap:32px}.fleet-photo :global(.archive-figure img){height:auto;max-height:360px}.fleet-comparison{padding-top:24px}.prose{font-size:18px}.fleet-heading h2{font-size:25px}.fleet-measure{padding-top:22px}}
  @media print{.fleet-controls,.fleet-count{display:none}.fleet-row{break-inside:avoid}.fleet-rows{gap:24px}}
</style>
<script>
  function initFleetComparison(){
    const root=document.querySelector<HTMLElement>('[data-fleet-comparison]');if(!root||root.dataset.ready)return;root.dataset.ready='true';
    const filters=[...root.querySelectorAll<HTMLButtonElement>('[data-fleet-filter]')];
    const params=new URLSearchParams(location.search);
    const requested=params.get('fleet')??'port-arthur';
    let group=filters.some(button=>button.dataset.fleetFilter===requested)?requested:'port-arthur';
    let view=params.get('view')==='table'?'table':'diagram';
    function update(){
      root!.querySelectorAll<HTMLElement>('[data-fleet-record]').forEach(row=>{
        const groupMatch=row.dataset.group===group||(group==='port-arthur'&&row.dataset.group==='port-arthur-support');
        row.hidden=!!group&&!groupMatch;
      });
      filters.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.fleetFilter===group)));
      root!.querySelector('[data-fleet-count]')!.textContent=String(root!.querySelectorAll('.fleet-row:not([hidden])').length);
      root!.querySelectorAll<HTMLElement>('[data-fleet-view]').forEach(panel=>panel.hidden=panel.dataset.fleetView!==view);
      root!.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.view===view)));
      const params=new URLSearchParams();if(group!=='port-arthur')params.set('fleet',group);if(view==='table')params.set('view',view);
      history.replaceState(history.state,'',location.pathname+(params.size?'?'+params.toString():'')+location.hash);
    }
    filters.forEach(button=>button.addEventListener('click',()=>{group=button.dataset.fleetFilter!;update();}));root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button=>button.addEventListener('click',()=>{view=button.dataset.view!;update();}));update();
  }
  document.addEventListener('astro:page-load',initFleetComparison);
</script>
