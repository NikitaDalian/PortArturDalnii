---
import Base from '../layouts/Base.astro';
import Coast from '../components/Coast.astro';
import { href } from '../lib/data';
import { t } from '../i18n/ru';
const links = [
  { label: t.nav.layers, href: href.layers() },
  { label: t.nav.people, href: href.people() },
  { label: 'Карта', href: href.map() },
  { label: 'Маршруты', href: href.routes() },
  { label: t.nav.library, href: href.library() },
  { label: t.nav.notes, href: href.notes() },
  { label: 'Указатель А–Я', href: href.index() },
];
---
<Base searchable={false} title="Страница не найдена" description="Такой страницы на сайте нет. Поиск и разделы сайта «Портъ-Артуръ и Дальнiй».">
  <section class="dark nf page-top">
    <div class="container nf__inner page-top__inner">
      <p class="eyebrow eyebrow--accent">Ошибка 404</p>
      <h1 class="h1">Такой страницы нет</h1>
      <p class="lead">Возможно, адрес изменился или в нём опечатка. Попробуйте поиск или начните с одного из разделов.</p>
      <form class="nf__search" action={href.search()} method="get" role="search">
        <label class="sr-only" for="nf-q">{t.search}</label>
        <input id="nf-q" name="q" type="search" placeholder={t.searchPlaceholder} autocomplete="off" />
        <button class="btn btn--primary" type="submit">Найти</button>
      </form>
      <div class="cluster" style="--cluster-gap:12px 24px">
        <a class="btn btn--outline btn--sm" href={href.home()}>На главную</a>
      </div>
    </div>
    <Coast />
  </section>
  <nav class="section--tight container" aria-label="Разделы сайта">
    <h2 class="h3" style="margin-bottom:16px">Разделы</h2>
    <ul class="nf__links" role="list">
      {links.map((l) => <li><a class="chip" href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
</Base>

<style>
  .nf__inner { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .nf__search { display: flex; flex-wrap: wrap; gap: 10px; width: 100%; max-width: 560px; margin-top: 8px; }
  .nf__search input { flex: 1 1 240px; min-width: 0; min-height: 52px; padding: 0 22px; border-radius: var(--radius-pill);
    border: 1.5px solid var(--sea); background: var(--navy-2); color: #fff; font: inherit; font-size: 17px; }
  .nf__search input::placeholder { color: var(--steel); }
  .nf__search input:focus-visible { border-color: #fff; }
  .nf__links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 520px) { .nf__search .btn { flex: 1 1 100%; } }
</style>
