---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Timeline from '../../components/layers/Timeline.astro';
import KeyDates from '../../components/layers/KeyDates.astro';
import { href, entity, plural } from '../../lib/data';
import { LAYERS, layerText, layerArticles, layerPeople, layerPlaces } from '../../components/layers/layers';

const blocks = LAYERS.map((l) => {
  const notes = layerArticles(l.key);
  return {
    l,
    text: layerText[l.key],
    count: notes.length,
    people: layerPeople(l.key).slice(0, 4),
    places: layerPlaces(l.key).slice(0, 3),
  };
});

const chronology = LAYERS.flatMap((l) =>
  layerText[l.key].dates.filter((d) => d.key).map((d) => ({ ...d, layer: l.key })),
).sort((a, b) => a.year - b.year);

const title = 'Слои истории';
const lead = 'Пять эпох одного места на южной оконечности Ляодуна: китайский Люйшунькоу, русские Порт-Артур и Дальний, японские Рёдзюн и Дайрен, советская база и сегодняшний Далянь.';
---
<Base title={title} description={lead} section="layers">
  <PageHero
    title={title}
    eyebrow="Ляодунский полуостров"
    lead={lead}
    crumbs={[{ label: 'Главная', href: href.home() }, { label: title }]}
  />

  <section class="container section--tight" aria-labelledby="scale-h">
    <h2 id="scale-h" class="sr-only">Шкала эпох</h2>
    <Timeline />
  </section>

  <section class="container section" aria-labelledby="layers-h">
    <div class="section-head">
      <h2 id="layers-h" class="h2">Пять слоёв</h2>
      <a class="link" href="#chrono">Хронология</a>
    </div>
    <ol class="lb-list">
      {blocks.map(({ l, text, count, people, places }, i) => (
        <li class:list={['lb reveal', { 'lb--dark dark': l.key === 'russian' }]} style={`--d:${i * 60}ms`}>
          <div class="lb__head">
            <span class="lb__years">{l.years}</span>
            <h3 class="lb__title"><a href={href.layer(l.key)}>{l.title}</a></h3>
          </div>
          <div class="lb__body stack" style="--stack-gap:14px">
            <p class="lb__text">{text.card}</p>
            <p class="meta">{count} {plural(count, 'заметка', 'заметки', 'заметок')}</p>
            {people.length > 0 && (
              <p class="lb__rel"><span class="lb__label">Лица:</span>{' '}
                {people.map((p, j) => <><a class="text-link" href={href.person(p.slug)}>{p.short || p.name}</a>{j < people.length - 1 ? ', ' : ''}</>)}
              </p>
            )}
            {places.length > 0 && (
              <p class="lb__rel"><span class="lb__label">Места:</span>{' '}
                {places.map((p, j) => {
                  const e = entity('place', p.slug);
                  return <>{e.href ? <a class="text-link" href={e.href}>{e.label}</a> : e.label}{j < places.length - 1 ? ', ' : ''}</>;
                })}
              </p>
            )}
          </div>
          <a class="btn btn--outline btn--sm lb__go" href={href.layer(l.key)} aria-label={`Открыть слой «${l.title}»`}>Открыть слой →</a>
        </li>
      ))}
    </ol>
  </section>

  <section id="chrono" class="paper section" aria-labelledby="chrono-h">
    <div class="container">
      <div class="section-head">
        <div class="stack" style="--stack-gap:10px">
          <p class="eyebrow">Ключевые даты</p>
          <h2 id="chrono-h" class="h2">Хронология</h2>
        </div>
        <p class="meta lb-note">Даты до 1918 года для России — по старому стилю, в скобках по новому.</p>
      </div>
      <div class="reveal"><KeyDates items={chronology} showLayer /></div>
    </div>
  </section>
</Base>

<style>
  .lb-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; background: var(--line); }
  .lb { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) auto; gap: 16px 40px; align-items: start; padding: clamp(24px, 3vw, 36px) clamp(20px, 3vw, 36px); background: var(--paper); }
  .lb__head { display: flex; flex-direction: column; gap: 10px; }
  .lb__years { font-size: 15px; font-weight: 700; color: var(--ink-3); }
  .lb--dark .lb__years { color: var(--accent-on-dark); }
  .lb__title { font-size: clamp(26px, 2.6vw, 36px); line-height: 1.1; }
  .lb__title a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .lb__text { font-size: 18px; line-height: 1.5; color: var(--ink-2); }
  .lb--dark .lb__text { color: var(--mist); }
  .lb__rel { font-size: 16px; line-height: 1.6; }
  .lb__label { font-weight: 700; }
  .lb__go { align-self: center; white-space: nowrap; }
  .lb-note { max-width: 36ch; }
  @media (max-width: 960px) {
    .lb { grid-template-columns: 1fr; }
    .lb__go { justify-self: start; }
  }
</style>
