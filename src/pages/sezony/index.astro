---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Unsure from '../../components/Unsure.astro';
import { seasons, href, img, focusStyle, entity, placeBySlug } from '../../lib/data';
import { SEASONS, sortedRoutes } from '../../components/map/places';
import { seasonArt, loop } from '../../lib/art';
const order = ['spring', 'summer', 'autumn', 'winter'] as const;
const months: Record<string, string> = { spring: 'март — май', summer: 'июнь — август', autumn: 'сентябрь — ноябрь', winter: 'декабрь — февраль' };
const rs = sortedRoutes();
---
<Base title="Сезоны" description="Когда ехать в Люйшунь и Далянь: сакура и акация весной, море летом, гинкго и прозрачный воздух осенью, памятные даты обороны Порт-Артура зимой." section="map">
  <PageHero
    title="Сезоны"
    eyebrow="Карта и маршруты"
    lead="Что смотреть в Люйшуне и Даляне в разное время года: цветение, море, осенние виды с сопок и даты обороны крепости. Сроки цветения сдвигаются от года к году, поэтому многие пункты помечены как уточняемые."
    crumbs={[{ label: 'Главная', href: href.home() }, { label: 'Сезоны' }]}
  >
    <nav class="chip-row" aria-label="Сезоны">
      {order.map((s) => <a class="chip" href={`#${s}`}>{SEASONS[s].label}</a>)}
    </nav>
  </PageHero>

  {order.map((s, si) => {
    const items = (seasons[s] || []) as any[];
    const srs = rs.filter((r) => (r.season as string[]).includes(s));
    return (
      <section id={s} class:list={['section', 'section--tight', 'sz', { paper: si % 2 === 1 }]} style={`--c:${SEASONS[s].color}`} aria-labelledby={`${s}-h`}>
        <div class="container">
          <div class="sz__head">
            {seasonArt(s, 720) && (
              <div class="sz__art" aria-hidden="true">
                {loop(`season-${s}`)
                  ? <video muted loop playsinline autoplay preload="metadata" poster={seasonArt(s, 720)} data-season-video><source src={loop(`season-${s}`)!.webm} type="video/webm" /><source src={loop(`season-${s}`)!.mp4} type="video/mp4" /></video>
                  : <img src={seasonArt(s, 720)} alt="" loading="lazy" decoding="async" />}
              </div>
            )}
            <span class="sz__bar" aria-hidden="true"></span>
            <div class="stack" style="--stack-gap:4px">
              <h2 class="h2" id={`${s}-h`}>{SEASONS[s].label}</h2>
              <p class="meta">{months[s]}</p>
            </div>
          </div>
          <ul class="sz__list" role="list">
            {items.map((it, i) => {
              const pl = it.place ? placeBySlug.get(it.place) : null;
              const e = it.place ? entity('place', it.place) : null;
              const photo = pl?.photos?.[0] ? img(pl.photos[0], 640) : null;
              return (
                <li class="sz__item reveal" style={`--d:${Math.min(i, 5) * 70}ms`}>
                  {photo && <img class="sz__img" src={photo} alt="" loading="lazy" decoding="async" style={focusStyle(pl?.photos?.[0])} />}
                  <div class="stack" style="--stack-gap:8px; min-width:0">
                    <p class="sz__when">{it.when}</p>
                    <h3 class="h3">{it.title}</h3>
                    {it.note && <p class="muted sz__note">{it.note}</p>}
                    <div class="cluster" style="--cluster-gap:10px">
                      {e && (e.href ? <a class="link" href={e.href}>{e.label}</a> : <span class="meta">{e.label}</span>)}
                      {pl && <a class="sz__map" href={href.map(pl.slug)}>на карте</a>}
                      {it.verify && <Unsure />}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
          {srs.length > 0 && (
            <div class="sz__routes stack" style="--stack-gap:10px">
              <span class="meta">Маршруты сезона</span>
              <div class="chip-row">
                {srs.map((r) => <a class="chip" href={href.route(r.slug)}>{r.title}</a>)}
              </div>
            </div>
          )}
        </div>
      </section>
    );
  })}
</Base>

<script>
  // Сезонные петли: играют, только пока видны; при reduced-motion — стоп-кадр.
  function pauseOffscreen() {
    const vids = document.querySelectorAll<HTMLVideoElement>('[data-season-video]');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { vids.forEach((v) => v.pause()); return; }
    const io = new IntersectionObserver((es) => es.forEach((e) => { const v = e.target as HTMLVideoElement; e.isIntersecting ? v.play().catch(() => {}) : v.pause(); }));
    vids.forEach((v) => io.observe(v));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', pauseOffscreen);
</script>

<style>
  .sz__art { flex: 0 0 auto; width: clamp(120px, 16vw, 200px); aspect-ratio: 1; overflow: hidden; background: var(--frost); }
  .sz__art video, .sz__art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (prefers-reduced-motion: reduce) { .sz__art video { display: none; } }
  .sz__head { display: flex; gap: 16px; align-items: stretch; margin-bottom: 28px; }
  .sz__bar { flex: none; width: 8px; border-radius: 4px; background: var(--c); }
  .sz__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); }
  .sz__item { display: flex; gap: 16px; padding: 20px; background: var(--paper); border-top: 4px solid var(--c); }
  .paper .sz__item { background: var(--ice); }
  .sz__img { flex: 0 0 96px; width: 96px; height: 96px; object-fit: cover; }
  .sz__when { font-size: 14px; font-weight: 700; color: var(--ink); }
  .sz__note { font-size: 16px; line-height: 1.5; }
  .sz__map { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 600; color: var(--ink-3); text-decoration: underline; text-underline-offset: 3px; }
  .sz__routes { margin-top: 24px; }
  @media (max-width: 520px) { .sz__img { flex-basis: 72px; width: 72px; height: 72px; } .sz__item { padding: 16px; } }
</style>
