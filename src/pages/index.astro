---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import LayersGrid from '../components/home/LayersGrid.astro';
import MapTeaser from '../components/home/MapTeaser.astro';
import PeopleTeaser from '../components/home/PeopleTeaser.astro';
import SeriesStrip from '../components/home/SeriesStrip.astro';
import SeasonsGrid from '../components/home/SeasonsGrid.astro';
import Authors from '../components/home/Authors.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BookRow from '../components/BookRow.astro';
import { articles, books, sources, bookBySlug, href, TG_CHANNEL, type Book } from '../lib/data';

// Библиотека: по книге на каждый уровень (start / deep / fiction) + ещё одна для начала.
const bookPicks = ['martin-russko-yaponskaya-voyna', 'lilye-dnevnik-osady-port-artura', 'stepanov-port-artur', 'veresaev-na-yaponskoy-voyne']
  .map((s) => bookBySlug.get(s)).filter(Boolean) as Book[];
for (const lvl of ['start', 'deep', 'fiction']) {
  if (!bookPicks.some((b) => b.level === lvl)) {
    const b = books.find((x) => x.level === lvl);
    if (b) bookPicks.push(b);
  }
}
const libTotal = books.length + sources.length;

const latest = [...articles].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
---
<Base searchable={false}>
  <Hero />
  <LayersGrid />
  <MapTeaser />
  <PeopleTeaser />

  <section class="section container" aria-labelledby="lib-h">
    <div class="section-head reveal" style="margin-bottom:12px">
      <h2 id="lib-h" class="h2">Библиотека</h2>
      <a class="link" href={href.library()}>Весь каталог · {libTotal}</a>
    </div>
    <p class="lead reveal" style="--d:60ms; margin-bottom:28px">
      Книги, разобранные в канале. У каждой есть аннотация, оценка автора и ссылка на рецензию в Telegram.
    </p>
    <div class="grid row-list home-books">
      {bookPicks.slice(0, 4).map((b, i) => (
        <div class="reveal" style={`--d:${i * 70}ms`}><BookRow b={b} /></div>
      ))}
    </div>
  </section>

  <section class="paper home-notes" aria-labelledby="notes-h">
    <div class="container section">
      <div class="section-head reveal">
        <h2 id="notes-h" class="h2">Свежие заметки</h2>
        <a class="link" href={href.notes()}>Все заметки · {articles.length}</a>
      </div>
      <div class="grid" style="--min:280px; --grid-gap:32px">
        {latest.map((a, i) => (
          <div class="reveal" style={`--d:${i * 70}ms`}><ArticleCard a={a} /></div>
        ))}
      </div>
      <div class="cluster home-notes__actions reveal" style="--cluster-gap:12px 24px">
        <a class="btn btn--outline" href={TG_CHANNEL} target="_blank" rel="noopener">
          Читать канал в Telegram
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg>
        </a>
        <a class="link" href={href.index()}>Указатель А–Я</a>
        <a class="link" href={href.search()}>Поиск по сайту</a>
      </div>
    </div>
  </section>

  <SeriesStrip />
  <SeasonsGrid />
  <Authors />
</Base>

<style>
  .home-books { --min: 420px; --grid-gap: 0 48px; }
  .home-books > div { display: flex; flex-direction: column; }
  .home-books :global(.book-row) { flex: 1; }
  .home-notes { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .home-notes__actions { margin-top: 40px; }
  @media (max-width: 720px) {
    .home-notes__actions .btn { width: 100%; }
  }
</style>
