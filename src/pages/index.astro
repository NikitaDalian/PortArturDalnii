---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ReadFirst from '../components/home/ReadFirst.astro';
import ExplorePaths from '../components/home/ExplorePaths.astro';
import Authors from '../components/home/Authors.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { essays } from '../lib/essays';
import { updatesTitle } from '../lib/updates';
import { articles, href, TG_CHANNEL } from '../lib/data';
import { assetUrl } from '../i18n/locale';

const latest = [
  ...essays.map(item=>({kind:'essay' as const,date:item.date,item})),
  ...articles.map(item=>({kind:'note' as const,date:item.date,item})),
].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,3);
---
<Base searchable={false}>
  <Hero />
  <div class="container home-byline"><p>Автор — Виктория, историк, живёт в Даляне.</p><a href={`${href.about()}#viktoriia`}>О проекте и авторе</a></div>
  <ReadFirst />
  <ExplorePaths />
  <section class="paper home-new" aria-labelledby="new-title">
    <div class="container section">
      <div class="section-head"><h2 class="h2" id="new-title">Новое на сайте</h2><a class="link" href={href.updates()}>{updatesTitle}</a></div>
      <div class="home-new-grid">
        {latest.map(entry=>entry.kind==='note' ? <ArticleCard a={entry.item} /> : <article class="home-essay">
          {entry.item.illustration&&<a href={href.essay(entry.item.slug)} tabindex="-1" aria-hidden="true"><img src={assetUrl(entry.item.illustration.image)} alt="" width="960" height="640" loading="lazy" /></a>}
          <h3><a href={href.essay(entry.item.slug)}>{entry.item.title}</a></h3>
          <p>{entry.item.dek}</p><a class="link" href={href.essay(entry.item.slug)}>Читать статью</a>
        </article>)}
      </div>
    </div>
  </section>
  <div class="home-author"><Authors /></div>
  <div class="container home-follow"><a class="btn btn--outline" href={TG_CHANNEL} target="_blank" rel="noopener">Читать канал в Telegram</a><a class="link" href={href.search()}>Поиск по сайту</a></div>
</Base>
<style>
  .home-byline{display:flex;align-items:baseline;justify-content:space-between;gap:12px 24px;padding-block:20px;font-size:15px;color:var(--ink-2)}.home-byline a{text-decoration:underline;text-underline-offset:4px}.home-new{border-block:1px solid var(--line)}.home-new-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.home-essay{display:flex;flex-direction:column;gap:18px;min-width:0}.home-essay img{width:100%;height:240px;object-fit:contain;background:var(--frost)}.home-essay h3{font-size:26px;line-height:1.25}.home-essay h3 a:hover{text-decoration:underline}.home-essay p{font-size:17px;line-height:1.65;color:var(--ink-2)}.home-essay>.link{margin-top:auto;align-self:flex-start;min-height:44px;display:flex;align-items:center}.home-author{padding-top:64px}.home-follow{display:flex;flex-wrap:wrap;gap:16px 28px;align-items:center;padding-bottom:56px}
  @media(max-width:900px){.home-new-grid{grid-template-columns:1fr;gap:36px}.home-essay img{height:280px}.home-byline{flex-direction:column;gap:8px}.home-author{padding-top:40px}}
</style>
