---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Unsure from '../../components/Unsure.astro';
import MiniMap from '../../components/map/MiniMap.astro';
import { routeArt } from '../../lib/art';
import { routes, href, img, plural, type Route } from '../../lib/data';
import { sortedRoutes, routeAuthor, routeCover, routeStops, routeYandex, TRANSPORT, SEASONS, KINDS, isUncertain, photoCaption } from '../../components/map/places';

export function getStaticPaths() {
  return routes.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
interface Props { r: Route }
const { r } = Astro.props;
const author = routeAuthor(r);
const stops = routeStops(r);
const cover = routeCover(r);
const artUrl = routeArt(r.slug, 1280);
const total = stops.reduce((s, x) => s + (x.minutes || 0), 0);
const fmtMin = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} ч${m % 60 ? ` ${m % 60} мин` : ''}` : `${m} мин`);
const line = ((r as any).polyline as [number, number][] | undefined) ?? null;
const points = stops.filter((s) => s.p).map((s, i) => ({ lat: s.p!.lat, lng: s.p!.lng, n: i + 1, name: s.p!.name, href: href.place(s.p!.slug) }));
const others = sortedRoutes().filter((x) => x.slug !== r.slug).slice(0, 4);
const mapHref = href.mapRoute(r.slug);
const km = `${String(r.distance_km).replace('.', ',')} км`;
---
<Base title={r.title} description={r.dek} image={artUrl ?? img(cover)} section="map">
  <PageHero
    title={r.title}
    eyebrow={author ? `Маршрут от авторов · ${author}` : 'Маршрут'}
    lead={r.dek}
    crumbs={[{ label: 'Главная', href: href.home() }, { label: 'Маршруты', href: href.routes() }, { label: r.title }]}
    image={artUrl}
    transitionName={`route-${r.slug}`}
  >
    <dl class="rt-facts">
      <div><dt>Время</dt><dd>{r.duration}</dd></div>
      <div><dt>Длина</dt><dd>≈ {km}</dd></div>
      <div><dt>Как</dt><dd>{TRANSPORT[r.transport] ?? r.transport}</dd></div>
      {r.difficulty && <div><dt>Сложность</dt><dd>{r.difficulty}</dd></div>}
      <div><dt>Сезон</dt><dd>{(r.season as string[]).map((s) => SEASONS[s]?.label).filter(Boolean).join(', ')}</dd></div>
    </dl>
    <div class="cluster rt-actions">
      <a class="btn btn--primary" href={mapHref}>Открыть на карте</a>
      <a class="btn btn--outline" href={routeYandex(r)} target="_blank" rel="noopener">Маршрут в Яндекс.Картах</a>
      <button type="button" class="btn btn--outline" data-share={r.title}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="18" cy="5" r="2.5"></circle><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><path d="M8.2 10.8l7.6-4.4M8.2 13.2l7.6 4.4"></path></svg>
        Поделиться
      </button>
      <span class="rt-copied meta" role="status" aria-live="polite"></span>
    </div>
  </PageHero>

  <section class="section section--tight" aria-labelledby="rt-map">
    <div class="container stack" style="--stack-gap:16px">
      <div class="section-head" style="margin-bottom:0">
        <h2 class="h2" id="rt-map">Схема</h2>
        <a class="link" href={mapHref}>На большой карте</a>
      </div>
      <MiniMap label={`Схема маршрута «${r.title}»`} points={points} line={line} height="clamp(300px, 52vh, 520px)" zoom={16} />
      <p class="meta">Линия соединяет остановки напрямую и не повторяет дороги. Длина ориентировочная; маршрут по улицам покажут Яндекс.Карты или Amap.</p>
    </div>
  </section>

  <section class="section section--tight paper" aria-labelledby="rt-stops">
    <div class="container split rt-split">
      <div class="stack" style="--stack-gap:20px">
        <div class="stack" style="--stack-gap:6px">
          <h2 class="h2" id="rt-stops">Остановки</h2>
          <p class="muted">{stops.length} {plural(stops.length, 'остановка', 'остановки', 'остановок')}{total ? `, на месте около ${fmtMin(total)} без учёта дороги` : ''}</p>
        </div>
        <ol class="rt-list" role="list">
          {stops.map((s, i) => (
            <li class="rt-stop reveal" style={`--d:${Math.min(i, 5) * 70}ms`}>
              <span class="rt-stop__n" aria-hidden="true">{i + 1}</span>
              <div class="rt-stop__body">
                {s.p ? (
                  <a class="rt-stop__media" href={href.place(s.p.slug)} tabindex="-1" aria-hidden="true">
                    {s.p.photos?.[0]
                      ? <img src={img(s.p.photos[0], 640)} alt="" loading="lazy" decoding="async" />
                      : <span class="rt-stop__ph"></span>}
                  </a>
                ) : null}
                <div class="stack" style="--stack-gap:6px; min-width:0">
                  <span class="meta">
                    {s.time ? `${s.time} · ` : ''}{s.p ? KINDS[s.p.kind] ?? '' : ''}{s.minutes ? ` · ${fmtMin(s.minutes)}` : ''}
                  </span>
                  <h3 class="rt-stop__title">
                    {s.p ? <a href={href.place(s.p.slug)}>{s.p.name}</a> : s.place}
                  </h3>
                  {s.p?.name_zh && s.p.name_zh !== '—' && <span class="rt-stop__zh" lang="zh">{s.p.name_zh.split(';')[0]}</span>}
                  {s.note && <p class="rt-stop__note">{s.note}</p>}
                  {s.p && isUncertain(s.p) && <Unsure text={s.p.coord_confidence === 'low' ? 'точка приблизительная, уточняется' : 'сведения уточняются'} />}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <aside class="stack rt-aside" style="--stack-gap:16px">
        {r.practical && (
          <div class="panel panel--frost stack" style="--stack-gap:10px">
            <h2 class="h3">Практические советы</h2>
            <p>{r.practical}</p>
            <p class="meta">Часы работы и цены меняются — уточните перед поездкой.</p>
          </div>
        )}
        <div class="panel stack rt-own" style="--stack-gap:10px">
          <h2 class="h3">Хотите по-своему?</h2>
          <p class="muted">На карте можно отметить любые места: сайт сам выстроит порядок обхода и даст ссылку для Яндекс.Карт.</p>
          <a class="link" href={href.mapPts(stops.filter((s) => s.p).map((s) => s.p!.slug))}>Взять остановки за основу</a>
        </div>
      </aside>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section section--tight" aria-labelledby="rt-more">
      <div class="container stack" style="--stack-gap:20px">
        <div class="section-head" style="margin-bottom:0">
          <h2 class="h2" id="rt-more">Другие маршруты</h2>
          <a class="link" href={href.routes()}>Все маршруты</a>
        </div>
        <ul class="rt-more" role="list">
          {others.map((x) => (
            <li><a class="rt-more__a" href={href.route(x.slug)}>
              <span class="meta">{routeAuthor(x) ? 'От авторов · ' : ''}{TRANSPORT[x.transport] ?? x.transport} · {x.duration}</span>
              <span class="rt-more__t">{x.title}</span>
            </a></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<script>
  function init() {
    document.querySelectorAll<HTMLButtonElement>('[data-share]:not([data-ready])').forEach((b) => {
      b.dataset.ready = '1';
      b.addEventListener('click', async () => {
        const u = location.href.split('#')[0];
        const out = b.parentElement!.querySelector('.rt-copied');
        try {
          if (navigator.share) { await navigator.share({ title: b.dataset.share, url: u }); return; }
          await navigator.clipboard.writeText(u);
          if (out) out.textContent = 'Ссылка скопирована';
        } catch { /* отмена */ }
      });
    });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .rt-facts { display: flex; flex-wrap: wrap; gap: 12px 32px; margin: 8px 0 0; }
  .rt-facts dt { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--steel); }
  .rt-facts dd { margin: 2px 0 0; font-size: 17px; font-weight: 600; color: #fff; }
  .rt-actions { margin-top: 8px; }
  .rt-copied { color: var(--steel); }
  .rt-split > :last-child { flex: 1 1 320px; }
  .rt-aside { align-self: flex-start; }
  @media (min-width: 900px) { .rt-aside { position: sticky; top: calc(var(--header-h) + 24px); } }
  .rt-list { list-style: none; margin: 0; padding: 0; position: relative; }
  .rt-stop { position: relative; display: flex; gap: 16px; padding-bottom: 28px; }
  .rt-stop:not(:last-child)::before { content: ''; position: absolute; left: 17px; top: 40px; bottom: 4px; width: 2px; background: repeating-linear-gradient(var(--accent) 0 6px, transparent 6px 11px); }
  .rt-stop__n { flex: none; width: 36px; height: 36px; border-radius: 18px; background: var(--navy); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .rt-stop__body { flex: 1; min-width: 0; display: flex; gap: 16px; align-items: flex-start; }
  .rt-stop__media { flex: 0 0 132px; display: block; overflow: hidden; }
  .rt-stop__media img, .rt-stop__ph { width: 132px; aspect-ratio: 4 / 3; object-fit: cover; display: block; background: var(--frost); }
  .rt-stop__title { font-size: 20px; line-height: 1.2; font-weight: 700; }
  .rt-stop__title a { text-decoration: underline; text-decoration-color: var(--line-2); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .rt-stop__title a:hover { text-decoration-color: var(--accent); }
  .rt-stop__zh { font-size: 14px; color: var(--ink-3); }
  .rt-stop__note { font-size: 16px; line-height: 1.55; color: var(--ink-2); }
  @media (max-width: 560px) {
    .rt-stop__body { flex-direction: column; }
    .rt-stop__media { flex-basis: auto; width: 100%; }
    .rt-stop__media img, .rt-stop__ph { width: 100%; aspect-ratio: 16 / 9; }
  }
  .rt-more { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .rt-more__a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 16px 18px; background: var(--paper); border: 1px solid var(--line); transition: border-color .2s; }
  .rt-more__a:hover { border-color: var(--navy); }
  .rt-more__t { font-size: 18px; font-weight: 700; line-height: 1.25; }
</style>
