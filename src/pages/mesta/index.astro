---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import ExploreNav from '../../components/map/ExploreNav.astro';
import { href, places } from '../../lib/data';
import { CITIES } from '../../components/map/places';
const groups = ['dalian', 'lushun', 'other'].map(city => ({ city, title: CITIES[city], places: places.filter(p => p.city === city) })).filter(g => g.places.length);
---
<Base title="Места и маршруты" description="Исторические места Даляня и Люйшуня: рассказы о зданиях и укреплениях, карта и маршруты для самостоятельной прогулки." section="places" searchable={false}>
  <PageHero title="Места и маршруты" lead="Выберите место, чтобы прочитать его историю, или маршрут для прогулки. На карте можно увидеть, что находится рядом, и собрать свой путь." crumbs={[{label:'Главная',href:href.home()},{label:'Места и маршруты'}]}>
    <div class="cluster">
      <a class="btn btn--primary" href={href.routes()}>Выбрать маршрут</a>
      <a class="btn btn--outline" href={href.map()}>Открыть карту</a>
    </div>
    <ExploreNav current="places" />
  </PageHero>
  <div class="container section--tight">
    <nav class="cluster" style="--cluster-gap:12px 24px" aria-label="Выбрать город">{groups.map(g => <a class="text-link" href={`#${g.city}`}>{g.title}</a>)}</nav>
    <p class="places-intro">Один город хранит следы нескольких эпох. На страницах мест собраны прежние названия, фотографии, связанные статьи и сведения для посещения.</p>
  </div>
  {groups.map(g => <section class="container section" id={g.city} aria-labelledby={`${g.city}-title`}>
    <div class="section-head"><h2 class="h2" id={`${g.city}-title`}>{g.title}</h2></div>
    <div class="grid" style="--min:260px; --grid-gap:32px 24px">{g.places.map(p => <PlaceCard p={p} />)}</div>
  </section>)}
</Base>
<style>.places-intro { max-width:66ch; margin-top:24px; font-size:18px; line-height:1.7; }</style>
